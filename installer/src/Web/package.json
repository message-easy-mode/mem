{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "docs:build": "node ./scripts/build-documentation-pack.mjs --write",
    "docs:check": "node ./scripts/build-documentation-pack.mjs --check",
    "prebuild": "npm run docs:check",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "npm run test:e2e:deployed",
    "test:e2e:dev": "node ./scripts/assert-e2e-env.mjs dev && playwright test --project=local-development tests/e2e/backup-catalog.dev.spec.ts",
    "test:e2e:deployed": "node ./scripts/assert-e2e-env.mjs deployed && playwright test --project=deployed-live tests/e2e/backup-catalog.deployed.spec.ts",
    "test:e2e:turn-live": "node ./scripts/assert-e2e-env.mjs turn-live && playwright test --project=live tests/e2e/stack-turn.live.spec.ts",
    "test:e2e:coturn-resilience-live": "node ./scripts/assert-e2e-env.mjs coturn-resilience-live && playwright test --project=live tests/e2e/coturn-resilience.live.spec.ts",
    "test:e2e:migration-live": "node ./scripts/assert-e2e-env.mjs migration-live && playwright test --project=live tests/e2e/migration-guided.live.spec.ts",
    "test:e2e:diagnostics-dev": "node ./scripts/assert-e2e-env.mjs diagnostics-dev && playwright test --project=local-development tests/e2e/diagnostics.dev.spec.ts",
    "test:e2e:diagnostics-deployed": "node ./scripts/assert-e2e-env.mjs diagnostics-deployed && playwright test --project=deployed-live tests/e2e/diagnostics.deployed.spec.ts",
    "test:e2e:local": "node ./scripts/assert-e2e-env.mjs local && playwright test --project=local-development tests/e2e/environment-parity.bootstrap.spec.ts",
    "test:e2e:local:restart": "node ./scripts/assert-e2e-env.mjs local-restart && playwright test --project=local-development tests/e2e/environment-parity.restart.spec.ts",
    "test:e2e:container": "node ./scripts/assert-e2e-env.mjs container && playwright test --project=containerized-development tests/e2e/environment-parity.bootstrap.spec.ts",
    "test:e2e:container:restart": "node ./scripts/assert-e2e-env.mjs container-restart && playwright test --project=containerized-development tests/e2e/environment-parity.restart.spec.ts",
    "test:e2e:all": "../../../dev/mem-env e2e all",
    "docs:sync": "node ./scripts/sync-documentation-from-website.mjs --sync",
    "docs:sync:check": "node ./scripts/sync-documentation-from-website.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "msw": "^2.14.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.0",
    "vitest": "^4.1.9"
  }
}
