{
  "Health": {
    "EnableReadyCheck": true
  },
  "Product": {
    "Version": "0.2.0"
  },
  "MemRuntime": {
    "AllowSharedDockerHost": false,
    "Mode": "containerized-production",
    "StateRoot": "/data",
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "ContainerName": "mem-control-plane",
    "UiDeliveryMode": "embedded-spa",
    "InstanceIdentityFileName": "control-plane/runtime-instance.json"
  },
  "Aio": {
    "SqlitePath": "data/mem-installer.dev.db"
  },
  "DataProtection": {
    "ApplicationName": "matrix-easy-mode.control-plane",
    "KeyRingPath": "/data/data-protection-keys"
  },
  "MemOperatorIdentity": {
    "CookieName": "mem_operator_auth",
    "CookieIdleMinutes": 30,
    "BootstrapCookieName": "mem_bootstrap_auth",
    "BootstrapGrantMinutes": 15,
    "BootstrapRecoveryCodeCount": 10,
    "EnrollmentCookieName": "mem_operator_enrollment",
    "EnrollmentGrantMinutes": 15,
    "EnrollmentRecoveryCodeCount": 10,
    "PasswordMinimumLength": 14,
    "PasswordRequiredUniqueChars": 4,
    "LockoutMinutes": 15,
    "LockoutMaxFailedAccessAttempts": 5,
    "LoginRateLimitPermitLimit": 20,
    "LoginRateLimitWindowSeconds": 60,
    "StepUpGrantMinutes": 15,
    "SecurityStampValidationSeconds": 0,
    "OperatorRecoveryCodeCount": 10
  },
  "MemCliDeviceSessions": {
    "AuthorizationAttemptMinutes": 10,
    "SessionIdleMinutes": 480,
    "SessionAbsoluteHours": 168,
    "AuthorizationStartRateLimitPermitLimit": 10,
    "AuthorizationStartRateLimitWindowSeconds": 60,
    "AuthorizationPollRateLimitPermitLimit": 60,
    "AuthorizationPollRateLimitWindowSeconds": 60
  },
  "InstallerAuth": {
    "TokenEnvironmentVariableName": "MEM_CONTROL_PLANE_SETUP_TOKEN",
    "TokenPathEnvironmentVariableName": "MEM_CONTROL_PLANE_SETUP_TOKEN_PATH",
    "DefaultTokenPath": "/data/setup-token",
    "CookieName": "mem_installer_auth",
    "SessionHours": 12,
    "LegacyTokenEnvironmentVariableName": "MEM_INSTALLER_SETUP_TOKEN",
    "LegacyTokenPathEnvironmentVariableName": "MEM_INSTALLER_SETUP_TOKEN_PATH"
  },
  "Orchestration": {
    "PostgresReadyTimeoutSeconds": 90,
    "NpmReadyTimeoutSeconds": 90,
    "PollDelaySeconds": 2
  },
  "RuntimeImages": {
    "Postgres": {
      "ApprovedReference": "docker.io/library/postgres:16@sha256:33f923b05f64ca54ac4401c01126a6b92afe839a0aa0a52bc5aeb5cc958e5f20",
      "RequiredMajorVersion": 16,
      "ExpectedVersion": "16.14",
      "AllowInstallPull": true,
      "AllowOperationalPull": false
    },
    "Synapse": {
      "ApprovedReference": "matrixdotorg/synapse@sha256:6882d26594b87171e0fe807ac6bd7f0000665cd70e73fb88c58ec9bff14c19ce",
      "AllowPreparationPull": true,
      "AllowOperationalPull": false,
      "ExpectedVersion": "1.156.0"
    },
    "Element": {
      "ApprovedReference": "vectorim/element-web@sha256:2a65f32acc6fd7163523d1c4b5174de354b5ceb085898b15898f4d8ea01a8e3d",
      "AllowPreparationPull": true,
      "AllowOperationalPull": false,
      "ExpectedVersion": "1.12.23"
    },
    "Coturn": {
      "ApprovedReference": "coturn/coturn@sha256:0c0e8fc0c263b85a134e9e4242b5e46e1f4c077c5029633511191c05b5c2c814",
      "ExpectedVersion": "4.14.0",
      "AllowInstallPull": true,
      "AllowOperationalPull": false
    }
  },
  "Coturn": {
    "StorageRootPath": "/var/lib/message-easy-mode/platform/coturn"
  },
  "Migration": {
    "MemMigrateCommand": "/opt/mem/migrate/current/mem-migrate"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "MemCliHostCommand": {
    "Enabled": false,
    "InstallScriptPath": "/opt/mem/bootstrap/cli/install-host-command.sh",
    "BinaryPath": "/opt/mem/bootstrap/cli/mem",
    "Version": "dev",
    "InstallRoot": "/opt/mem/cli",
    "LinkPath": "/usr/local/bin/mem"
  },
  "Diagnostics": {
    "Logging": {
      "PersistentFileEnabled": true,
      "FilePath": "/data/logs/control-plane/mem-control-plane-.clef",
      "FileSizeLimitMiB": 25,
      "RetainedFileCountLimit": 28,
      "FlushIntervalMilliseconds": 1000,
      "CorrelationHeaderName": "X-Correlation-ID",
      "LowDiskWarningMiB": 1024,
      "CriticalDiskWarningMiB": 256
    },
    "Seq": {
      "SinkEnabled": false,
      "ManagementEnabled": false,
      "IngestionUrl": "http://seq:5341",
      "UiUrl": null,
      "HealthUrl": "http://seq:80",
      "ApiKeyEnvironmentVariableName": "MEM_SEQ_API_KEY",
      "ApiKeyFilePath": "/data/secrets/seq/ingestion-api-key",
      "AdminPasswordHashEnvironmentVariableName": "MEM_SEQ_ADMIN_PASSWORD_HASH",
      "AdminPasswordHashFilePath": "/data/secrets/seq/admin-password-hash",
      "EulaAccepted": false,
      "ApprovedImageReference": "datalust/seq:2026.1.17044",
      "ExpectedVersion": "2026.1.17044",
      "AllowOperationalPull": false,
      "HostDataPath": "/var/lib/message-easy-mode/seq",
      "PreferredHostPort": 15341,
      "ProbeTimeoutSeconds": 5,
      "ProbeIntervalSeconds": 30,
      "DeliveryStatePath": "/data/diagnostics/seq-delivery.json",
      "AllowSetupPull": true,
      "PasswordHashTimeoutSeconds": 30,
      "BootstrapHealthAttemptCount": 45,
      "BootstrapHealthPollIntervalSeconds": 2,
      "SecretRootPath": "/data/secrets/seq",
      "BootstrapStatePath": "/data/diagnostics/seq-bootstrap.json"
    },
    "SafeEvents": {
      "Enabled": true,
      "RootPath": "/data/diagnostics",
      "RetentionDays": 14,
      "MaximumTotalBytes": 268435456,
      "EventFileMaximumBytes": 8388608,
      "MaximumEventBytes": 65536,
      "DefaultQueryWindowHours": 24,
      "MaximumQueryWindowHours": 168,
      "DefaultPageSize": 100,
      "MaximumPageSize": 200,
      "MaximumDetailCharacters": 1500,
      "MaximumStackTraceCharacters": 12000,
      "MaximumExceptionDepth": 6,
      "RetentionIntervalMinutes": 360,
      "LowDiskWarningBytes": 1073741824,
      "CriticalDiskWarningBytes": 268435456,
      "SupportReportMaximumRequestBytes": 4096,
      "SupportReportMaximumBytes": 2097152,
      "SupportReportMaximumDockerLogCharacters": 20000
    },
    "DockerEvidence": {
      "Enabled": true,
      "DefaultTailLines": 100,
      "MaximumTailLines": 500,
      "MaximumCharacters": 30000,
      "MaximumRawBytes": 1048576,
      "MaximumFrameBytes": 1048576,
      "TimeoutSeconds": 8
    },
    "TestFixture": {
      "Enabled": false
    },
    "Portainer": {
      "ApprovedImageReference": "portainer/portainer-ce:2.39.5",
      "ExpectedVersion": "2.39.5",
      "ContainerName": "portainer",
      "DataVolumeName": "portainer_data",
      "PreferredHttpsHostPort": 9443,
      "AllowOperationalPull": false,
      "UiUrl": null,
      "EnvironmentId": null,
      "SupportedArchitectures": [
        "amd64",
        "arm64"
      ]
    }
  }
}
