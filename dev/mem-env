        MEM_STATE_ROOT="${E2E_LOCAL_DATA_ROOT}" MEM_DATA_ROOT="${E2E_LOCAL_MEM_DATA_ROOT}" MEM_CONTROL_PLANE_SETUP_TOKEN_PATH="${E2E_LOCAL_STATE}/setup-token" \
        MEM_DEV_ALLOW_SHARED_DOCKER_HOST=false InstallerAuth__DevelopmentSetupToken= MemRuntime__UiDeliveryMode=vite \
        Aio__SqlitePath="${E2E_LOCAL_DATA_ROOT}/mem.db" DataProtection__KeyRingPath="${E2E_LOCAL_DATA_ROOT}/keys" \
        Certificates__Storage__RootPath="${E2E_LOCAL_DATA_ROOT}/certificates" \
        Diagnostics__Logging__FilePath="${E2E_LOCAL_DATA_ROOT}/logs/control-plane/mem-control-plane-.clef" \
        Diagnostics__SafeEvents__RootPath="${E2E_LOCAL_DATA_ROOT}/diagnostics" \
        Diagnostics__Seq__HostDataPath="${E2E_LOCAL_DATA_ROOT}/seq" \
        Diagnostics__Seq__DeliveryStatePath="${E2E_LOCAL_DATA_ROOT}/diagnostics/seq-delivery.json" \
        Diagnostics__Seq__SecretRootPath="${E2E_LOCAL_DATA_ROOT}/secrets/seq" \
        Diagnostics__Seq__BootstrapStatePath="${E2E_LOCAL_DATA_ROOT}/diagnostics/seq-bootstrap.json" \
        Diagnostics__Seq__ApiKeyFilePath="${E2E_LOCAL_DATA_ROOT}/secrets/seq/ingestion-api-key" \
        Diagnostics__Seq__AdminPasswordHashFilePath="${E2E_LOCAL_DATA_ROOT}/secrets/seq/admin-password-hash" \
        Provisioning__InstanceDataRoot="${E2E_LOCAL_DATA_ROOT}/host-data/instances" Coturn__StorageRootPath="${E2E_LOCAL_DATA_ROOT}/host-data/platform/coturn" \
        dotnet run --project "${LOCAL_API_PROJECT}" --no-launch-profile
    wait_for_runtime "${LOCAL_API_URL}" local-development vite false || { tail -n 120 "${E2E_LOCAL_STATE}/api.log" >&2 || true; return 1; }
    start_managed_process "E2E Vite UI" "${E2E_LOCAL_STATE}/vite.pid" "${E2E_LOCAL_STATE}/vite.log" "run dev" \
        env npm --prefix "${WEB_ROOT}" run dev -- --host 127.0.0.1 --port 5173 --strictPort
    for _ in $(seq 1 60); do curl --fail --silent --show-error --max-time 3 "${LOCAL_WEB_URL}/health/ready" >/dev/null 2>&1 && return 0; sleep 1; done
    tail -n 120 "${E2E_LOCAL_STATE}/vite.log" >&2 || true; return 1
}

e2e_local_stop() {
    local result=0
    stop_managed_process "E2E Vite UI" "${E2E_LOCAL_STATE}/vite.pid" "run dev" || result=1
    stop_managed_process "E2E local API" "${E2E_LOCAL_STATE}/api.pid" "Api.csproj" || result=1
    return "${result}"
}

e2e_container_prepare() {
    container_exists "${E2E_CONTAINER_NAME}" && docker rm -f "${E2E_CONTAINER_NAME}" >/dev/null || true
    docker network rm "${E2E_NETWORK_NAME}" >/dev/null 2>&1 || true
    [[ ! -d "${E2E_CONTAINER_STATE}" ]] || safe_remove_directory "${E2E_STATE_ROOT}/container" "${E2E_CONTAINER_STATE}"
    mkdir -p "${E2E_CONTAINER_DATA_ROOT}" "${E2E_CONTAINER_MEM_DATA_ROOT}" "${E2E_CONTAINER_LEGACY_MEM_DATA_ROOT}" "${E2E_CONTAINER_HOST_DATA_ROOT}"
    ensure_runtime_network "${E2E_NETWORK_NAME}"
    local version commit build_date
    version="$(resolve_product_version)"; commit="$(resolve_commit)"; build_date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    umask 077
    generate_setup_token > "${E2E_CONTAINER_STATE}/setup-token"
    chmod 600 "${E2E_CONTAINER_STATE}/setup-token"
    ensure_state_path_material "${E2E_CONTAINER_DATA_ROOT}" "${E2E_CONTAINER_STATE}/setup-token"
    write_env_file "${E2E_CONTAINER_STATE}/runtime.env" \
        "MEM_CONTROL_PLANE_IMAGE=mem-control-plane:local" "MEM_CONTROL_PLANE_HTTPS_PORT=8443" \
        "MEM_CONTROL_PLANE_STATE_ROOT=${E2E_CONTAINER_DATA_ROOT}" \
        "MEM_CONTROL_PLANE_MEM_DATA_ROOT=${E2E_CONTAINER_MEM_DATA_ROOT}" \
        "MEM_CONTROL_PLANE_LEGACY_MEM_DATA_ROOT=${E2E_CONTAINER_LEGACY_MEM_DATA_ROOT}" \
        "MEM_CONTROL_PLANE_HOST_DATA_ROOT=${E2E_CONTAINER_HOST_DATA_ROOT}" "MEM_CONTROL_PLANE_CONTAINER_NAME=${E2E_CONTAINER_NAME}" \
        "MEM_CONTROL_PLANE_NETWORK_NAME=${E2E_NETWORK_NAME}" \
        "MEM_CONTROL_PLANE_COMPOSE_PROJECT=${E2E_COMPOSE_PROJECT}" "MEM_PRODUCT_VERSION=${version}" "MEM_COMMIT_SHA=${commit}" "MEM_BUILD_DATE=${build_date}"
}

compose_e2e() { docker compose --env-file "${E2E_CONTAINER_STATE}/runtime.env" --file "${COMPOSE_FILE}" "$@"; }

e2e_container_start() {
    local preserve_state="${1:-false}"
    require_docker; require_command curl; require_command python3; require_command ss
    require_exclusive_docker_host "${E2E_CONTAINER_NAME}"
    if managed_process_running "${LOCAL_STATE}/api.pid" "Api.csproj" || managed_process_running "${LOCAL_STATE}/vite.pid" "run dev" || container_running "${DEV_CONTAINER_NAME}"; then
        die "The ordinary developer environment is active. Stop it before running E2E."
    fi
    if [[ "${preserve_state}" != true ]]; then
        ensure_port_free 8443 "E2E containerized Control Plane"
        e2e_container_prepare
        compose_e2e build mem-control-plane
        compose_e2e up --detach --no-build mem-control-plane
    else
        container_running "${E2E_CONTAINER_NAME}" || die "The E2E container is not running for restart proof."
        compose_e2e restart mem-control-plane
    fi
    wait_for_runtime "https://127.0.0.1:8443" containerized-development embedded-spa true
}

e2e_container_cleanup() {
    [[ ! -f "${E2E_CONTAINER_STATE}/runtime.env" ]] || compose_e2e down --remove-orphans >/dev/null 2>&1 || true
    docker network rm "${E2E_NETWORK_NAME}" >/dev/null 2>&1 || true
    [[ ! -d "${E2E_CONTAINER_STATE}" ]] || safe_remove_directory "${E2E_STATE_ROOT}/container" "${E2E_CONTAINER_STATE}"
}

run_parity_playwright() {
    local mode="$1" phase="$2" base_url setup_token auth_file expected_mode expected_ui script
    case "${mode}" in
        local) base_url="${LOCAL_WEB_URL}"; setup_token="$(cat "${E2E_LOCAL_STATE}/setup-token")"; auth_file="${E2E_AUTH_FILE_LOCAL}"; expected_mode=local-development; expected_ui=vite; script=test:e2e:local ;;
        container) base_url=https://127.0.0.1:8443; setup_token="$(cat "${E2E_CONTAINER_STATE}/setup-token")"; auth_file="${E2E_AUTH_FILE_CONTAINER}"; expected_mode=containerized-development; expected_ui=embedded-spa; script=test:e2e:container ;;
        *) die "Unknown E2E mode: ${mode}" ;;
    esac
    [[ "${phase}" != restart ]] || script="${script}:restart"
    env MEM_E2E_BASE_URL="${base_url}" MEM_E2E_SETUP_TOKEN="${setup_token}" MEM_E2E_AUTH_FILE="${auth_file}" \
        MEM_E2E_EXPECTED_RUNTIME_MODE="${expected_mode}" MEM_E2E_EXPECTED_UI_DELIVERY_MODE="${expected_ui}" \
        npm --prefix "${WEB_ROOT}" run "${script}"
}

e2e_run_local() (
    set -Eeuo pipefail
    trap 'e2e_local_stop >/dev/null 2>&1 || true; [[ ! -d "${E2E_LOCAL_STATE}" ]] || safe_remove_directory "${E2E_STATE_ROOT}/local" "${E2E_LOCAL_STATE}"' EXIT
    e2e_local_start false; run_parity_playwright local bootstrap; e2e_local_stop; e2e_local_start true; run_parity_playwright local restart
    log "E2E local-development passed."
)

e2e_run_container() (
    set -Eeuo pipefail
    trap 'e2e_container_cleanup' EXIT
    e2e_container_start false; run_parity_playwright container bootstrap; e2e_container_start true; run_parity_playwright container restart
    log "E2E containerized-development passed."
)

e2e_command() {
    case "${1:-}" in
        local) e2e_run_local ;;
        container) e2e_run_container ;;
        all) e2e_run_local; e2e_run_container; log "E2E all passed: local-development then containerized-development." ;;
        *) die "e2e requires local, container, or all" ;;
    esac
}

status_line() {
    printf '%-27s %s\n' "$1" "$2"
}

managed_local_api_watch_enabled() {
    local pid
    pid="$(read_pid_file "${LOCAL_STATE}/api.pid" 2>/dev/null || true)"
    [[ -n "${pid}" ]] || return 1
    pid_matches "${pid}" "dotnet watch"
}

status() {
    require_command curl
    require_command python3
    require_command ss
    printf 'MEM developer environment\n\n'

    if interactive_authority_ready; then
        status_line "Interactive authority" "shared · ready"
        status_line "Authority source" "$(read_authority_value MEM_INTERACTIVE_AUTHORITY_SOURCE || printf unknown)"
        status_line "MEM data root" "${INTERACTIVE_MEM_DATA_ROOT}"
    elif [[ -e "${INTERACTIVE_STATE}" ]]; then
        status_line "Interactive authority" "incomplete · manual inspection required"
    elif ! interactive_legacy_retired && { legacy_local_state_present || legacy_container_state_present; }; then
        status_line "Interactive authority" "migration required · use authority adopt local|container"
    else
        status_line "Interactive authority" "not initialized · next start creates shared state"
    fi

    if managed_process_running "${LOCAL_STATE}/api.pid" "Api.csproj"; then
        status_line "Local API" "running · ${LOCAL_API_URL}"
        if managed_local_api_watch_enabled; then
            status_line "API source watch" "enabled · full restart on backend save"
        else
            status_line "API source watch" "disabled · one-shot process"
        fi
        local local_runtime
        if local_runtime="$(runtime_json "${LOCAL_API_URL}" false 2>/dev/null)"; then
            printf '%s' "${local_runtime}" | format_runtime_json
        else
            status_line "Local runtime context" "unavailable"
        fi
    elif port_is_listening 7105; then
        status_line "Local API" "occupied by an unmanaged process"
    else
        status_line "Local API" "stopped"
    fi

    if managed_process_running "${LOCAL_STATE}/vite.pid" "run dev"; then
        status_line "Vite UI" "running · ${LOCAL_WEB_URL}"
    elif port_is_listening 5173; then
        status_line "Vite UI" "occupied by an unmanaged process"
    else
        status_line "Vite UI" "stopped"
    fi

    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        if container_running "${DEV_CONTAINER_NAME}"; then
            status_line "Containerized Control Plane" "running · ${CONTAINER_URL}"
            local container_runtime
            if container_runtime="$(runtime_json "${CONTAINER_URL}" true 2>/dev/null)"; then
                printf '%s' "${container_runtime}" | format_runtime_json
            else
                status_line "Container runtime context" "unavailable"
            fi
        elif container_exists "${DEV_CONTAINER_NAME}"; then
            status_line "Containerized Control Plane" "stopped"
        else
            status_line "Containerized Control Plane" "not created"
        fi

        printf '\nSeq runtimes\n'
        seq_context_status local
        seq_context_status container
        local other_seq
        other_seq="$(other_managed_seq_container_names | paste -sd ', ' -)"
        if [[ -n "${other_seq}" ]]; then
            status_line "Other MEM Seq runtimes" "${other_seq} · observed only"
        fi

        local other
        other="$(competing_control_plane_names "${DEV_CONTAINER_NAME}")"
        if [[ -n "${other}" ]]; then
            status_line "Other MEM controllers" "$(echo "${other}" | paste -sd ', ' -)"
            status_line "Docker ownership" "conflict"
        else
            status_line "Docker ownership" "exclusive"
        fi
    else
        status_line "Docker" "unavailable"
    fi
}

doctor() {
    local failed=false
    for command in bash curl docker dotnet git id npm openssl python3 setsid ss tar; do
        if command -v "${command}" >/dev/null 2>&1; then
            status_line "${command}" "available"
        else
            status_line "${command}" "missing"
            failed=true
        fi
    done

    if command -v docker >/dev/null 2>&1; then
        if docker info >/dev/null 2>&1; then
            status_line "Docker daemon" "available"
        else
            status_line "Docker daemon" "unavailable to current user"
            failed=true
        fi
        if docker compose version >/dev/null 2>&1; then
            local compose_version
            compose_version="$(docker compose version --short 2>/dev/null | tr -d '\r' | head -n 1)"
            if compose_supports_additional_contexts "${compose_version}"; then
                status_line "Docker Compose" "${compose_version} · additional contexts supported"
            else
                status_line "Docker Compose" "${compose_version:-unknown} · requires ${MIN_COMPOSE_ADDITIONAL_CONTEXTS_VERSION}+"
                failed=true
            fi
        else
            status_line "Docker Compose" "missing"
            failed=true
        fi
    fi

    [[ "${failed}" == false ]] || return 1
}

host_reset_is_protected_control_plane_name() {
    local name="$1"
    [[ "${name}" == "mem-control-plane" ||
       "${name}" == "mem-installer" ]]
}

host_reset_is_legacy_mem_name() {
    local name="$1"
    [[ "${name}" == mem-* ]]
}

host_reset_managed_container() {
    local name="$1"
    [[ "$(docker_container_label "${name}" "${MEM_MANAGED_LABEL}")" == "true" ]]
}

docker_volume_label() {
    local name="$1"
    local key="$2"
    docker volume inspect \
        --format "{{with index .Labels \"${key}\"}}{{.}}{{end}}" \
        "${name}" 2>/dev/null || true
}

docker_container_named_volumes() {
    local name="$1"
    docker inspect \
        --format '{{range .Mounts}}{{if eq .Type "volume"}}{{println .Name}}{{end}}{{end}}' \
        "${name}" 2>/dev/null | awk 'NF' || true
}

host_reset_is_legacy_mem_volume_name() {
    local name="$1"
    [[ "${name}" == mem-* || "${name}" == mem_* ]]
}

host_reset_is_mem_compose_project() {
    local project="$1"
    [[ "${project}" == "mem" ||
       "${project}" == mem-* ||
       "${project}" == message-easy-mode* ]]
}

host_reset_volume_has_mem_compose_provenance() {
    local name="$1"
    local project
    project="$(docker_volume_label "${name}" "${COMPOSE_PROJECT_LABEL}")"
    [[ -n "${project}" ]] && host_reset_is_mem_compose_project "${project}"
}

docker_network_label() {
    local name="$1"
    local key="$2"
    docker network inspect \
        --format "{{with index .Labels \"${key}\"}}{{.}}{{end}}" \
        "${name}" 2>/dev/null || true
}

host_reset_list_protected_control_planes() {
    local name
    docker ps -a --format '{{.Names}}' 2>/dev/null | while IFS= read -r name; do
        [[ -n "${name}" ]] || continue
        host_reset_is_protected_control_plane_name "${name}" &&
            printf '%s\n' "${name}"
    done
}

host_reset_list_target_containers() {
    local include_canonical="${1:-false}"
    local name
    docker ps -a --format '{{.Names}}' 2>/dev/null | while IFS= read -r name; do
        [[ -n "${name}" ]] || continue

        if host_reset_is_protected_control_plane_name "${name}"; then
            [[ "${include_canonical}" == true ]] && printf '%s\n' "${name}"
            continue
        fi

        if host_reset_managed_container "${name}" ||
           host_reset_is_legacy_mem_name "${name}"; then
            printf '%s\n' "${name}"
        fi
    done | LC_ALL=C sort -u
}

host_reset_list_target_container_volumes() {
    local include_canonical="${1:-false}"
    local container_name
    while IFS= read -r container_name; do
        [[ -n "${container_name}" ]] || continue
        docker_container_named_volumes "${container_name}"
    done < <(host_reset_list_target_containers "${include_canonical}")
}

host_reset_list_target_volumes() {
    local include_canonical="${1:-false}"
    {
        local name
        docker volume ls --format '{{.Name}}' 2>/dev/null | while IFS= read -r name; do
            [[ -n "${name}" ]] || continue
            if [[ "$(docker_volume_label "${name}" "${MEM_MANAGED_LABEL}")" == "true" ]] ||
               host_reset_volume_has_mem_compose_provenance "${name}" ||
               host_reset_is_legacy_mem_volume_name "${name}"; then
                printf '%s\n' "${name}"
            fi
        done

        # Some managed services historically let Docker create their named
        # volumes implicitly. Those volumes can therefore lack MEM or Compose
        # labels even though their owning container is proven as a reset target.
        # Include named volumes mounted by the exact target-container set. An
        # unrelated container cannot contribute a volume to this list.
        host_reset_list_target_container_volumes "${include_canonical}"
    } | awk 'NF' | LC_ALL=C sort -u
}

host_reset_list_target_networks() {
    local name
    docker network ls --format '{{.Name}}' 2>/dev/null | while IFS= read -r name; do
        [[ -n "${name}" ]] || continue
        case "${name}" in
            bridge|host|none) continue ;;
        esac
        if [[ "${name}" == mem-* ]] ||
           [[ "$(docker_network_label "${name}" "${MEM_MANAGED_LABEL}")" == "true" ]]; then
            printf '%s\n' "${name}"
        fi
    done | LC_ALL=C sort -u
}

host_reset_find_target_volume_container() {
    local volume_name="$1"
    local container_name mounted_volume
    while IFS= read -r container_name; do
        [[ -n "${container_name}" ]] || continue
        while IFS= read -r mounted_volume; do
            [[ "${mounted_volume}" == "${volume_name}" ]] || continue
            printf '%s\n' "${container_name}"
            return 0
        done < <(docker_container_named_volumes "${container_name}")
    done < <(host_reset_list_target_containers true)
    return 1
}

host_reset_resource_reason() {
    local kind="$1"
    local name="$2"

    case "${kind}" in
        container)
            if host_reset_is_protected_control_plane_name "${name}"; then
                printf '%s\n' 'explicit canonical Control Plane inclusion'
            elif [[ "$(docker_container_label "${name}" "${MEM_MANAGED_LABEL}")" == "true" ]]; then
                printf 'MEM managed label'
                local runtime resource
                runtime="$(docker_container_label "${name}" "${MEM_RUNTIME_MODE_LABEL}")"
                resource="$(docker_container_label "${name}" "${MEM_RESOURCE_LABEL}")"
                [[ -n "${runtime}" ]] && printf ' · runtime=%s' "${runtime}"
                [[ -n "${resource}" ]] && printf ' · resource=%s' "${resource}"
                printf '\n'
            else
                printf '%s\n' 'legacy MEM name'
            fi
            ;;
        volume)
            if [[ "$(docker_volume_label "${name}" "${MEM_MANAGED_LABEL}")" == "true" ]]; then
                printf '%s\n' 'MEM managed label'
            elif host_reset_volume_has_mem_compose_provenance "${name}"; then
                local compose_project compose_volume
                compose_project="$(docker_volume_label "${name}" "${COMPOSE_PROJECT_LABEL}")"
                compose_volume="$(docker_volume_label "${name}" "${COMPOSE_VOLUME_LABEL}")"
                printf 'Docker Compose MEM provenance · project=%s' "${compose_project}"
                [[ -n "${compose_volume}" ]] && printf ' · volume=%s' "${compose_volume}"
                printf '\n'
            elif host_reset_is_legacy_mem_volume_name "${name}"; then
                printf '%s\n' 'legacy MEM name'
            else
                local owning_container
                owning_container="$(host_reset_find_target_volume_container "${name}" || true)"
                if [[ -n "${owning_container}" ]]; then
                    printf 'named volume mounted by reset-target container · container=%s\n' "${owning_container}"
                else
                    printf '%s\n' 'MEM reset target'
                fi
            fi
            ;;
        network)
            if [[ "$(docker_network_label "${name}" "${MEM_MANAGED_LABEL}")" == "true" ]]; then
                printf '%s\n' 'MEM managed label'
            else
                printf '%s\n' 'legacy MEM name'
            fi
            ;;
        *) printf '%s\n' 'unknown' ;;
    esac
}

host_reset_print_group() {
    local title="$1"
    local kind="$2"
    shift 2
    local values=("$@")

    printf '%s\n' "${title}"
    if [[ "${#values[@]}" -eq 0 ]]; then
        printf '  (none)\n'
        return
    fi

    local value reason
    for value in "${values[@]}"; do
        reason="$(host_reset_resource_reason "${kind}" "${value}")"
        printf '  - %s  [%s]\n' "${value}" "${reason}"
    done
}

host_reset_plan() {
    local include_canonical="${1:-false}"
    local -a containers volumes networks protected

    mapfile -t containers < <(host_reset_list_target_containers "${include_canonical}")
    mapfile -t volumes < <(host_reset_list_target_volumes "${include_canonical}")
    mapfile -t networks < <(host_reset_list_target_networks)
    mapfile -t protected < <(host_reset_list_protected_control_planes)

    printf 'MEM clean-room development-host reset plan\n\n'
    host_reset_print_group "Containers to remove" container "${containers[@]}"
    printf '\n'
    host_reset_print_group "Volumes to remove" volume "${volumes[@]}"
    printf '\n'
    host_reset_print_group "Networks to remove" network "${networks[@]}"
    printf '\n'

    printf 'Repository development state to remove\n'
    local state_path state_expected state_suffix
    while IFS='|' read -r state_expected state_path; do
        [[ -n "${state_path}" ]] || continue
        state_suffix=""
        if host_reset_directory_requires_privileged_cleanup \
            "${state_expected}" "${state_path}"; then
            state_suffix="  [privileged cleanup required]"
        fi
        printf '  - %s%s\n' "${state_path}" "${state_suffix}"
    done <<EOF_STATE_PATHS
${REPO_ROOT}/installer/data|${LEGACY_LOCAL_DATA_ROOT}
${LEGACY_LOCAL_MEM_DATA_ROOT}|${LEGACY_LOCAL_MEM_DATA_ROOT}
${STATE_ROOT}/interactive|${INTERACTIVE_STATE}
${STATE_ROOT}/local|${LOCAL_STATE}
${STATE_ROOT}/container|${CONTAINER_STATE}
${STATE_ROOT}/e2e|${E2E_STATE_ROOT}
EOF_STATE_PATHS
    printf '\n'

    printf 'Preserved\n'
    printf '  - Docker images and build cache\n'
    printf '  - containers, volumes, and networks outside the MEM managed/legacy namespace\n'
    printf '  - unrelated Portainer and other unrelated services\n'

    if [[ "${#protected[@]}" -gt 0 && "${include_canonical}" != true ]]; then
        printf '\nProtected canonical Control Plane containers\n'
        local name
        for name in "${protected[@]}"; do
            printf '  - %s\n' "${name}"
        done
        printf '\n'
        printf 'A complete clean-room reset requires --include-canonical-control-plane.\n'
        printf 'A running canonical Control Plane must still be stopped explicitly first.\n'
    fi
}

host_reset_assert_canonical_safe() {
    local include_canonical="${1:-false}"
    local name

    while IFS= read -r name; do
        [[ -n "${name}" ]] || continue
        if container_running "${name}"; then
            die "Host reset refused. Canonical Control Plane '${name}' is running. Stop it explicitly before using the clean-room reset."
        fi
        [[ "${include_canonical}" == true ]] ||
            die "Host reset refused. Stopped canonical Control Plane '${name}' is protected. Re-run the dry-run with --include-canonical-control-plane if this development host is intentionally disposable."
    done < <(host_reset_list_protected_control_planes)
}

resolve_safe_removal_path() {
    local expected="$1"
    local target="$2"
    local resolved_expected resolved_target

    resolved_expected="$(realpath -m "${expected}")"
    resolved_target="$(realpath -m "${target}")"

    [[ "${resolved_target}" == "${resolved_expected}" ]] ||
        die "Refusing to remove unexpected path: ${resolved_target}"

    printf '%s\n' "${resolved_target}"
}

host_reset_directory_requires_privileged_cleanup() {
    local expected="$1"
    local target="$2"
    local resolved_target

    resolved_target="$(resolve_safe_removal_path "${expected}" "${target}")"
    [[ -e "${resolved_target}" ]] || return 1

    # Container services such as Seq can create root/foreign-UID directories
    # inside repository-local bind mounts. Non-writable directories are the
    # important deletion boundary; read-only files in a writable directory can
    # still be removed by the directory owner.
    find "${resolved_target}" \
        -type d \
        ! -writable \
        -print -quit 2>/dev/null | grep -q .
}

host_reset_repository_cleanup_requires_privilege() {
    host_reset_directory_requires_privileged_cleanup \
        "${REPO_ROOT}/installer/data" "${LEGACY_LOCAL_DATA_ROOT}" ||
    host_reset_directory_requires_privileged_cleanup \
        "${LEGACY_LOCAL_MEM_DATA_ROOT}" "${LEGACY_LOCAL_MEM_DATA_ROOT}" ||
    host_reset_directory_requires_privileged_cleanup \
        "${STATE_ROOT}/interactive" "${INTERACTIVE_STATE}" ||
    host_reset_directory_requires_privileged_cleanup \
        "${STATE_ROOT}/local" "${LOCAL_STATE}" ||
    host_reset_directory_requires_privileged_cleanup \
        "${STATE_ROOT}/container" "${CONTAINER_STATE}" ||
    host_reset_directory_requires_privileged_cleanup \
        "${STATE_ROOT}/e2e" "${E2E_STATE_ROOT}"
}

host_reset_prepare_repository_cleanup() {
    HOST_RESET_PRIVILEGED_CLEANUP=false

    if ! host_reset_repository_cleanup_requires_privilege; then
        return 0
    fi

    require_command sudo
    log "Container-owned development-state files require privileged cleanup."
    log "Authorizing sudo before removing any Docker resources."
    sudo -v ||
        die "Host reset refused. Privileged repository-state cleanup is required, but sudo authorization failed."

    HOST_RESET_PRIVILEGED_CLEANUP=true
}

host_reset_remove_directory() {
    local expected="$1"
    local target="$2"
    local resolved_target

    resolved_target="$(resolve_safe_removal_path "${expected}" "${target}")"
    [[ -e "${resolved_target}" ]] || return 0

    if rm -rf -- "${resolved_target}" 2>/dev/null; then
        return 0
    fi

    [[ "${HOST_RESET_PRIVILEGED_CLEANUP}" == true ]] ||
        die "Failed to remove development state '${resolved_target}' with current-user permissions. Re-run the host reset so privileged cleanup can be authorized before destructive work begins."

    log "Removing container-owned development state with sudo: ${resolved_target}"
    sudo rm -rf -- "${resolved_target}" ||
        die "Privileged cleanup failed for '${resolved_target}'."

    [[ ! -e "${resolved_target}" ]] ||
        die "Privileged cleanup left development state behind: ${resolved_target}"
}

host_reset_verify_clean() {
    local include_canonical="${1:-false}"
    local remaining_containers remaining_volumes remaining_networks

    remaining_containers="$(host_reset_list_target_containers "${include_canonical}" | paste -sd ', ' -)"
    remaining_volumes="$(host_reset_list_target_volumes "${include_canonical}" | paste -sd ', ' -)"
    remaining_networks="$(host_reset_list_target_networks | paste -sd ', ' -)"

    [[ -z "${remaining_containers}" ]] ||
        die "Host reset incomplete. MEM containers remain: ${remaining_containers}"
    [[ -z "${remaining_volumes}" ]] ||
        die "Host reset incomplete. MEM volumes remain: ${remaining_volumes}"
    [[ -z "${remaining_networks}" ]] ||
        die "Host reset incomplete. MEM networks remain: ${remaining_networks}"
}

reset_host() {
    local dry_run=false
    local include_canonical=false
    local confirmation=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            --include-canonical-control-plane)
                include_canonical=true
                shift
                ;;
            --confirm)
                [[ $# -ge 2 ]] || die "--confirm requires ${HOST_RESET_CONFIRMATION}"
                confirmation="$2"
                shift 2
                ;;
            *)
                die "Unknown host reset option: $1"
                ;;
        esac
    done

    require_docker
    require_command realpath
    require_command ss
    require_command find
    require_command grep

    if [[ "${dry_run}" == true ]]; then
        host_reset_plan "${include_canonical}"
        return 0
    fi

    [[ "${confirmation}" == "${HOST_RESET_CONFIRMATION}" ]] ||
        die "Host reset refused. Run --dry-run first, then re-run with --confirm ${HOST_RESET_CONFIRMATION}"

    host_reset_assert_canonical_safe "${include_canonical}"

    local_down || true
    if port_is_listening 7105; then
        die "Host reset refused. A local API is still listening on port 7105 outside this harness. Stop the VS Code/manual API explicitly before resetting the development host."
    fi

    # Establish any required privilege before the first Docker resource is
    # removed. This prevents a permission problem in a container-owned bind
    # mount from leaving the clean-room reset half-completed.
    host_reset_prepare_repository_cleanup

    local -a containers volumes networks
    mapfile -t containers < <(host_reset_list_target_containers "${include_canonical}")
    mapfile -t volumes < <(host_reset_list_target_volumes "${include_canonical}")
    mapfile -t networks < <(host_reset_list_target_networks)

    host_reset_plan "${include_canonical}"
    printf '\n'
    log "Executing clean-room development-host reset."

    local name
    for name in "${containers[@]}"; do
        container_exists "${name}" || continue
        log "Removing MEM container ${name}."
        docker rm --force "${name}" >/dev/null
    done

    for name in "${volumes[@]}"; do
        docker volume inspect "${name}" >/dev/null 2>&1 || continue
        log "Removing MEM volume ${name}."
        docker volume rm "${name}" >/dev/null ||
            die "Failed to remove MEM volume '${name}'. It may still be attached to a non-target container."
    done

    for name in "${networks[@]}"; do
        docker network inspect "${name}" >/dev/null 2>&1 || continue
        log "Removing MEM network ${name}."
        docker network rm "${name}" >/dev/null ||
            die "Failed to remove MEM network '${name}'. It may still have a non-target attachment."
    done

    host_reset_remove_directory "${REPO_ROOT}/installer/data" "${LEGACY_LOCAL_DATA_ROOT}"
    host_reset_remove_directory "${LEGACY_LOCAL_MEM_DATA_ROOT}" "${LEGACY_LOCAL_MEM_DATA_ROOT}"
    host_reset_remove_directory "${STATE_ROOT}/interactive" "${INTERACTIVE_STATE}"
    rm -f -- "${INTERACTIVE_LEGACY_RETIREMENT_FILE}"
    host_reset_remove_directory "${STATE_ROOT}/local" "${LOCAL_STATE}"
    host_reset_remove_directory "${STATE_ROOT}/container" "${CONTAINER_STATE}"
    host_reset_remove_directory "${STATE_ROOT}/e2e" "${E2E_STATE_ROOT}"

    host_reset_verify_clean "${include_canonical}"

    log "Clean-room development-host reset complete."
    log "Docker images and build cache were retained."
    log "The next Control Plane start should observe a host with no MEM runtime state."
}

require_reset_confirmation() {
    local supplied="${1:-}"
    [[ "${supplied}" == "${RESET_CONFIRMATION}" ]]
}

safe_remove_directory() {
    local expected="$1"
    local target="$2"
    local resolved_target
    resolved_target="$(resolve_safe_removal_path "${expected}" "${target}")"
    rm -rf -- "${resolved_target}"
}

reset_mode() {
    local mode="$1"
    shift
    local confirmation=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --confirm)
                [[ $# -ge 2 ]] || die "--confirm requires ${RESET_CONFIRMATION}"
                confirmation="$2"
                shift 2
                ;;
            *)
                die "Unknown reset option: $1"
                ;;
        esac
    done

    require_reset_confirmation "${confirmation}" ||
        die "Reset refused. Re-run with --confirm ${RESET_CONFIRMATION}"

    case "${mode}" in
        interactive)
            require_docker
            require_command ss
            local_down || true
            if port_is_listening 7105 || port_is_listening 5173; then
                die "Reset refused. A local API or Vite process is still active outside this harness. Stop it explicitly before resetting shared interactive state."
            fi
            if container_exists "${DEV_CONTAINER_NAME}"; then
                ensure_container_environment
                compose down --remove-orphans
            fi
            remove_scoped_seq_for_reset local
            remove_scoped_seq_for_reset container
            if [[ -d "${INTERACTIVE_STATE}" ]]; then
                docker run --rm \
                    -v "${INTERACTIVE_STATE}:/state" \
                    alpine:3.20 chown -R "$(id -u):$(id -g)" /state >/dev/null
                safe_remove_directory "${STATE_ROOT}/interactive" "${INTERACTIVE_STATE}"
            fi
            if [[ -d "${INTERACTIVE_HOST_DATA_ROOT}" ]]; then
                safe_remove_directory "${CONTAINER_STATE}/host-data" "${INTERACTIVE_HOST_DATA_ROOT}"
            fi
            log "Deleted shared interactive Control Plane state, canonical MEM data, and host resource data used by local and container development."
            log "Legacy ${LEGACY_LOCAL_MEM_DATA_ROOT} compatibility data remains preserved and retired; it is not re-adopted automatically."
            ;;
        local|container)
            die "Ordinary local and container modes now share one state authority. Use './dev/mem-env reset interactive --confirm ${RESET_CONFIRMATION}' instead."
            ;;
        *)
            die "Unknown reset mode: ${mode}"
            ;;
    esac
}

verify_switched_authority() {
    local expected="$1"
    local target="$2"
    [[ -n "${expected}" ]] || return 0

    local observed
    observed="$(runtime_control_plane_instance_for_mode "${target}" 2>/dev/null || true)"
    if [[ -z "${observed}" || "${observed}" != "${expected}" ]]; then
        if [[ "${target}" == local ]]; then
            local_down || true
        else
            container_down || true
        fi
        die "Runtime switch refused: shared Control Plane identity changed from ${expected} to ${observed:-unavailable}. The target runtime was stopped to prevent divergent mutation authority."
    fi
    log "Shared Control Plane identity preserved across switch: ${observed}"
}

switch_mode() {
    local target="$1"
    local expected_instance=""
    case "${target}" in
        local)
            expected_instance="$(runtime_control_plane_instance_for_mode container 2>/dev/null || true)"
            if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 &&
               container_exists "${DEV_CONTAINER_NAME}"; then
                container_down
            fi
            reconcile_interactive_host_data_for_local_switch
            local_up
            verify_switched_authority "${expected_instance}" local
            ;;
        container)
            expected_instance="$(runtime_control_plane_instance_for_mode local 2>/dev/null || true)"
            local_down
            container_up
            verify_switched_authority "${expected_instance}" container
            ;;
        *)
            die "Unknown switch target: ${target}"
            ;;
    esac
}

authority_command() {
    local action="${1:-}"
    case "${action}" in
        status)
            [[ $# -eq 1 ]] || die "authority status takes no additional arguments"
            require_command python3
            authority_status
            ;;
        adopt)
            [[ $# -eq 2 ]] || die "authority adopt requires local or container"
            authority_adopt "$2"
            ;;
        repair-mem-data)
            [[ $# -eq 1 ]] || die "authority repair-mem-data takes no additional arguments"
            repair_interactive_mem_data
            ;;
        *)
            die "authority requires status, adopt local|container, or repair-mem-data"
            ;;
    esac
}

local_command() {
    local action="${1:-}"
    shift || true

    case "${action}" in
        up|restart)
            local watch_enabled=true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --watch) watch_enabled=true ;;
                    --no-watch) watch_enabled=false ;;
                    *) die "local ${action} accepts only --watch or --no-watch" ;;
                esac
                shift
            done
            if [[ "${action}" == restart ]]; then
                local_down && local_up "${watch_enabled}"
            else
                local_up "${watch_enabled}"
            fi
            ;;
        down)
            [[ $# -eq 0 ]] || die "local down takes no additional arguments"
            local_down
            ;;
        logs)
            [[ $# -eq 0 ]] || die "local logs takes no additional arguments"
            local_logs
            ;;
        token)
            [[ $# -eq 0 ]] || die "local token takes no additional arguments"
            print_token local
            ;;
        *) die "Unknown local action: ${action:-<missing>}" ;;
    esac
}

container_command() {
    local action="${1:-}"
    case "${action}" in
        build) container_build ;;
        up) container_up ;;
        down) container_down ;;
        restart) container_down && container_up ;;
        logs) container_logs ;;
        token) print_token container ;;
        *) die "Unknown container action: ${action:-<missing>}" ;;
    esac
}

seq_command() {
    local target="${1:-}"
    case "${target}" in
        status)
            [[ $# -eq 1 ]] || die "seq status takes no additional arguments"
            require_command docker
            require_command curl
            require_command python3
            docker info >/dev/null 2>&1 || die "Docker is unavailable to the current user."
            printf 'MEM development Seq runtimes\n\n'
            seq_context_status local
            seq_context_status container
            local other_seq
            other_seq="$(other_managed_seq_container_names | paste -sd ', ' -)"
            if [[ -n "${other_seq}" ]]; then
                status_line "Other MEM Seq runtimes" "${other_seq} · observed only"
            fi
            ;;
        local|container)
            [[ $# -eq 2 ]] || die "seq ${target} requires inspect or logs"
            require_command docker
            require_command curl
            require_command python3
            docker info >/dev/null 2>&1 || die "Docker is unavailable to the current user."
            case "$2" in
                inspect) seq_safe_inspect "${target}" ;;
                logs) seq_logs "${target}" ;;
                *) die "seq ${target} requires inspect or logs" ;;
            esac
            ;;
        *) die "seq requires status, local, or container" ;;
    esac
}

main() {
    local command="${1:-}"
    case "${command}" in
        status) status ;;
        doctor) doctor ;;
        local) shift; local_command "$@" ;;
        container) shift; container_command "$@" ;;
        authority) shift; authority_command "$@" ;;
        host-data) shift; host_data_command "$@" ;;
        seq) shift; seq_command "$@" ;;
        e2e) shift; [[ $# -eq 1 ]] || die "e2e requires local, container, or all"; e2e_command "$1" ;;
        switch) shift; [[ $# -eq 1 ]] || die "switch requires local or container"; switch_mode "$1" ;;
        reset)
            shift
            [[ $# -ge 1 ]] || die "reset requires interactive or host"
            local mode="$1"
            shift
            if [[ "${mode}" == "host" ]]; then
                reset_host "$@"
            else
                reset_mode "${mode}" "$@"
            fi
            ;;
        help|--help|-h|"") usage ;;
        *) die "Unknown command: ${command}" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
