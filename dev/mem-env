usage() {
    cat <<'EOF_USAGE'
MEM developer environment

Usage:
  ./dev/mem-env status
  ./dev/mem-env doctor

  ./dev/mem-env local up [--watch|--no-watch]
  ./dev/mem-env local restart [--watch|--no-watch]
  ./dev/mem-env local down|logs|token
  ./dev/mem-env container build|up|down|restart|logs|token
  ./dev/mem-env switch local|container

  ./dev/mem-env authority status
  ./dev/mem-env authority adopt local|container
  ./dev/mem-env authority repair-mem-data

  ./dev/mem-env host-data status
  ./dev/mem-env host-data access

  ./dev/mem-env seq status
  ./dev/mem-env seq local|container inspect|logs

  ./dev/mem-env e2e local|container|all

  ./dev/mem-env reset interactive --confirm DELETE_MEM_DEV_STATE

  ./dev/mem-env reset host --dry-run
  ./dev/mem-env reset host --dry-run --include-canonical-control-plane
  ./dev/mem-env reset host --include-canonical-control-plane \
    --confirm DELETE_MEM_DEV_HOST_STATE

Normal down/restart operations preserve state. The ordinary local and container
Control Plane modes share one interactive development authority under
`dev/.state/interactive`; exactly one mutable Control Plane may use it at a time.
Context-scoped Seq runtimes may coexist and remain running while switching modes.
Managed local development defaults to backend source watch: a saved .NET source
change rebuilds and fully restarts the API. Use `local up --no-watch` for a
one-shot API process when a stable process is preferable.

Legacy separate local/container state is never merged automatically. If detected,
select the source explicitly with `authority adopt local|container` before the
first shared-authority start.

`reset interactive` deletes the shared interactive Control Plane state used by
both ordinary development modes. Disposable E2E state remains separate.

`reset host` is the exceptional clean-room operation. It returns a development
Docker host to an intentionally pre-MEM state by deleting discovered MEM
containers, MEM volumes/networks, local/container/E2E Control Plane state, and
legacy `mem-*` resources. Docker images/build cache are retained. It always
supports a non-destructive `--dry-run` first.

A canonical `mem-control-plane` or legacy permanent `mem-installer` container is
protected by default. A stopped canonical container requires the explicit
`--include-canonical-control-plane` flag. A running canonical container blocks
host reset even with that flag and must be stopped deliberately first.

Local and containerized Control Planes are exclusive by default and are never
started together by this harness.
EOF_USAGE
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

validate_port() {
    local value="$1"
    [[ "${value}" =~ ^[0-9]+$ ]] || return 1
    (( value >= 1 && value <= 65535 ))
}

port_is_listening() {
    local port="$1"
    ss -H -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${port}$"
}

pid_is_running() {
    local pid="$1"
    [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null
}

pid_command_line() {
    local pid="$1"
    tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true
}

pid_matches() {
    local pid="$1"
    local expected="$2"
    pid_is_running "${pid}" || return 1
    [[ "$(pid_command_line "${pid}")" == *"${expected}"* ]]
}

read_pid_file() {
    local file="$1"
    [[ -f "${file}" ]] || return 1
    tr -d '[:space:]' < "${file}"
}

managed_process_running() {
    local pid_file="$1"
    local expected="$2"
    local pid
    pid="$(read_pid_file "${pid_file}" 2>/dev/null || true)"
    [[ -n "${pid}" ]] && pid_matches "${pid}" "${expected}"
}

start_managed_process() {
    local label="$1"
    local pid_file="$2"
    local log_file="$3"
    local expected="$4"
    shift 4

    mkdir -p "$(dirname "${pid_file}")" "$(dirname "${log_file}")"
    if managed_process_running "${pid_file}" "${expected}"; then
        die "${label} is already running under this harness."
    fi

    : > "${log_file}"
    # Bash starts asynchronous commands with SIGINT and SIGQUIT ignored when
    # job control is disabled. Those ignored dispositions survive exec and make
    # a later kill -INT ineffective for detached managed processes such as
    # dotnet watch. Reset them explicitly before exec while setsid creates the
    # private process group owned by the harness.
    setsid env --default-signal=INT --default-signal=QUIT \
        "$@" >>"${log_file}" 2>&1 < /dev/null &
    local pid=$!
    printf '%s\n' "${pid}" > "${pid_file}"
    sleep 1

    if ! pid_matches "${pid}" "${expected}"; then
        rm -f "${pid_file}"
        tail -n 80 "${log_file}" >&2 || true
        die "${label} failed to start."
    fi
}

stop_managed_process() {
    local label="$1"
    local pid_file="$2"
    local expected="$3"
    local graceful_signal="${4:-TERM}"
    local pid

    case "${graceful_signal}" in
        TERM|INT) ;;
        *) die "Unsupported graceful shutdown signal for ${label}: ${graceful_signal}" ;;
    esac

    pid="$(read_pid_file "${pid_file}" 2>/dev/null || true)"

    if [[ -z "${pid}" ]]; then
        log "${label} is not recorded as running."
        return 0
    fi

    if ! pid_matches "${pid}" "${expected}"; then
        warn "Refusing to stop PID ${pid}; it is not the ${label} process started by this harness."
        rm -f "${pid_file}"
        return 1
    fi

    kill "-${graceful_signal}" -- "-${pid}" 2>/dev/null ||
        kill "-${graceful_signal}" "${pid}" 2>/dev/null || true
    for _ in $(seq 1 40); do
        if ! pid_is_running "${pid}"; then
            rm -f "${pid_file}"
            log "Stopped ${label}."
            return 0
        fi
        sleep 0.25
    done

    warn "${label} did not stop after SIG${graceful_signal}; sending SIGKILL to its owned process group."
    kill -KILL -- "-${pid}" 2>/dev/null || kill -KILL "${pid}" 2>/dev/null || true
    rm -f "${pid_file}"
}

is_recognized_control_plane_name() {
    local name="$1"
    [[ "${name}" == "mem-control-plane" ||
       "${name}" == "mem-installer" ||
       "${name}" == "mem-control-plane-dev" ||
       "${name}" == mem-control-plane-dev-* ]]
}

running_control_plane_names() {
    docker ps --format '{{.Names}}' 2>/dev/null | while IFS= read -r name; do
        if is_recognized_control_plane_name "${name}"; then
            printf '%s\n' "${name}"
        fi
    done
}

competing_control_plane_names() {
    local allowed="${1:-}"
    local name
    while IFS= read -r name; do
        [[ -n "${name}" ]] || continue
        if [[ -z "${allowed}" || "${name}" != "${allowed}" ]]; then
            printf '%s\n' "${name}"
        fi
    done < <(running_control_plane_names)
}

require_exclusive_docker_host() {
    local allowed="${1:-}"
    local competing
    competing="$(competing_control_plane_names "${allowed}")"
    if [[ -n "${competing}" ]]; then
        die "Another MEM Control Plane is active on this Docker host: $(echo "${competing}" | paste -sd ', ' -). Stop it explicitly before continuing."
    fi
}

compose_supports_additional_contexts() {
    local version="${1#v}"
    [[ "${version}" =~ ^[0-9]+([.][0-9]+){1,2}([.-].*)?$ ]] || return 1

    local first
    first="$(printf '%s\n%s\n' "${MIN_COMPOSE_ADDITIONAL_CONTEXTS_VERSION}" "${version}" | sort -V | head -n 1)"
    [[ "${first}" == "${MIN_COMPOSE_ADDITIONAL_CONTEXTS_VERSION}" ]]
}

require_docker() {
    require_command docker
    require_command sort
    docker info >/dev/null 2>&1 || die "Docker is unavailable to the current user."
    docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required."

    local compose_version
    compose_version="$(docker compose version --short 2>/dev/null | tr -d '\r' | head -n 1)"
    compose_supports_additional_contexts "${compose_version}" ||
        die "Docker Compose ${MIN_COMPOSE_ADDITIONAL_CONTEXTS_VERSION}+ is required because the Control Plane image builds MEM Migrate from an additional source context. Found: ${compose_version:-unknown}."
}

write_env_file() {
    local path="$1"
    shift
    mkdir -p "$(dirname "${path}")"
    : > "${path}"
    chmod 600 "${path}"
    printf '%s\n' "$@" >> "${path}"
}

generate_setup_token() {
    if command -v openssl >/dev/null 2>&1; then
        printf 'mem_%s\n' "$(openssl rand -hex 24)"
    else
        printf 'mem_%s_%s%s\n' "$(date +%s)" "${RANDOM}" "${RANDOM}"
    fi
}

path_has_entries() {
    local path="$1"
    [[ -d "${path}" ]] || return 1
    find "${path}" -mindepth 1 -print -quit 2>/dev/null | grep -q .
}

legacy_local_state_present() {
    path_has_entries "${LEGACY_LOCAL_DATA_ROOT}"
}

legacy_container_state_present() {
    command -v docker >/dev/null 2>&1 || return 1
    docker volume inspect "${LEGACY_CONTAINER_VOLUME_NAME}" >/dev/null 2>&1
}

interactive_legacy_retired() {
    [[ -f "${INTERACTIVE_LEGACY_RETIREMENT_FILE}" ]]
}

interactive_authority_ready() {
    [[ -f "${INTERACTIVE_AUTHORITY_FILE}" &&
       -d "${INTERACTIVE_DATA_ROOT}" &&
       -d "${INTERACTIVE_HOST_DATA_ROOT}" &&
       -s "${INTERACTIVE_SETUP_TOKEN_PATH}" ]]
}

read_authority_value() {
    local key="$1"
    [[ -f "${INTERACTIVE_AUTHORITY_FILE}" ]] || return 1
    sed -n "s/^${key}=//p" "${INTERACTIVE_AUTHORITY_FILE}" | head -n 1
}

write_authority_metadata() {
    local root="$1"
    local source="$2"
    write_env_file "${root}/authority.env" \
        "MEM_INTERACTIVE_AUTHORITY_VERSION=1" \
        "MEM_INTERACTIVE_AUTHORITY_SOURCE=${source}" \
        "MEM_INTERACTIVE_AUTHORITY_CREATED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

ensure_development_certificate() {
    local data_root="$1"
    local cert_dir="${data_root}/certs"
    local cert_path="${cert_dir}/mem-control-plane.crt"
    local key_path="${cert_dir}/mem-control-plane.key"

    if [[ -s "${cert_path}" && -s "${key_path}" ]]; then
        return 0
    fi
    if [[ -e "${cert_path}" || -e "${key_path}" ]]; then
        die "Incomplete development certificate state beneath ${cert_dir}; refusing to overwrite it."
    fi

    require_command openssl
    mkdir -p "${cert_dir}"
    umask 077
    openssl req -x509 -newkey rsa:3072 -sha256 -days 825 -nodes \
        -keyout "${key_path}" -out "${cert_path}" \
        -subj "/CN=MEM Control Plane Development" \
        -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" >/dev/null 2>&1
    chmod 600 "${key_path}"
    chmod 644 "${cert_path}"
}

mem_data_manifest_set_matches_active_database() {
    [[ -d "${INTERACTIVE_MEM_DATA_ROOT}" ]] || return 1
    require_command python3

    python3 - \
        "${INTERACTIVE_SQLITE_PATH}" \
        "${INTERACTIVE_MEM_DATA_ROOT}/control-plane/runtime-stacks" <<'PY'
import json
import pathlib
import sqlite3
import sys

db_path = pathlib.Path(sys.argv[1])
manifest_dir = pathlib.Path(sys.argv[2])

def norm_id(value):
    return (value or "").strip().lower().replace("-", "")

def norm(value):
    return (value or "").strip().lower()

manifest_rows = {}
if manifest_dir.is_dir():
    for path in sorted(manifest_dir.glob("*.json")):
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            raise SystemExit(1)
        stack_id = norm_id(payload.get("stackId"))
        slug = norm(payload.get("slug"))
        if not stack_id or len(stack_id) != 32 or not slug:
            raise SystemExit(1)
        if stack_id in manifest_rows:
            raise SystemExit(1)
        manifest_rows[stack_id] = slug

if not db_path.is_file():
    raise SystemExit(0 if not manifest_rows else 1)

con = None
try:
    con = sqlite3.connect(str(db_path))
    rows = con.execute(
        'SELECT Id, Slug, Status, LastVerifiedStatus FROM RuntimeStacks'
    ).fetchall()
except sqlite3.OperationalError:
    raise SystemExit(0 if not manifest_rows else 1)
finally:
    if con is not None:
        con.close()

active_rows = {}
for stack_id, slug, status, last_verified in rows:
    destroyed = (
        norm(status) == "destroyed"
        or norm(last_verified) == "destroyed"
        or "--destroyed-" in norm(slug)
    )
    if not destroyed:
        active_rows[norm_id(stack_id)] = norm(slug)

raise SystemExit(0 if active_rows == manifest_rows else 1)
PY
}

interactive_mem_data_authority_ready() {
    [[ -f "${INTERACTIVE_MEM_DATA_AUTHORITY_FILE}" ]] || return 1
    [[ -d "${INTERACTIVE_MEM_DATA_ROOT}" ]] || return 1
    grep -qx 'MEM_INTERACTIVE_MEM_DATA_READY=1' "${INTERACTIVE_MEM_DATA_AUTHORITY_FILE}" 2>/dev/null || return 1
    mem_data_manifest_set_matches_active_database
}

write_mem_data_authority_metadata() {
    local source="$1"
    write_env_file "${INTERACTIVE_MEM_DATA_AUTHORITY_FILE}" \
        "MEM_INTERACTIVE_MEM_DATA_READY=1" \
        "MEM_INTERACTIVE_MEM_DATA_SOURCE=${source}" \
        "MEM_INTERACTIVE_MEM_DATA_ROOT=${INTERACTIVE_MEM_DATA_ROOT}" \
        "MEM_INTERACTIVE_LEGACY_MEM_DATA_ROOT=${LEGACY_LOCAL_MEM_DATA_ROOT}" \
        "MEM_INTERACTIVE_MEM_DATA_UPDATED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

initialize_fresh_interactive_mem_data_authority() {
    mkdir -p "${INTERACTIVE_MEM_DATA_ROOT}"
    write_mem_data_authority_metadata fresh
}

assert_mem_data_repair_safe() {
    if managed_process_running "${LOCAL_STATE}/api.pid" "Api.csproj" ||
       managed_process_running "${LOCAL_STATE}/vite.pid" "run dev" ||
       port_is_listening 7105 || port_is_listening 5173; then
        die "MEM data authority repair requires the local API and Vite to be stopped, including manual/VS Code processes."
    fi
    if container_running "${DEV_CONTAINER_NAME}"; then
        die "MEM data authority repair requires ${DEV_CONTAINER_NAME} to be stopped. Run './dev/mem-env container down' first."
    fi
}

reconstruct_active_manifest_from_database() {
    local stack_id="$1"
    local output_path="$2"

    require_command dotnet
    ASPNETCORE_ENVIRONMENT=Development \
    MEM_RUNTIME_MODE=local-development \
    MEM_STATE_ROOT="${INTERACTIVE_DATA_ROOT}" \
    MEM_DATA_ROOT="${INTERACTIVE_MEM_DATA_ROOT}" \
    Aio__SqlitePath="${INTERACTIVE_SQLITE_PATH}" \
    dotnet run \
        --project "${LOCAL_API_PROJECT}" \
        --no-launch-profile \
        -- \
        runtime-manifest reconstruct "${stack_id}" "${output_path}"
}

repair_interactive_mem_data() {
    require_command python3
    require_command ss
    require_docker
    interactive_authority_ready ||
        die "Shared interactive Control Plane authority is not ready. Adopt or initialize it first."
    assert_mem_data_repair_safe

    if interactive_mem_data_authority_ready; then
        log "Shared MEM data authority is already ready: ${INTERACTIVE_MEM_DATA_ROOT}"
        return 0
    fi

    if path_has_entries "${INTERACTIVE_MEM_DATA_ROOT}" &&
       [[ ! -f "${INTERACTIVE_MEM_DATA_AUTHORITY_FILE}" ]]; then
        die "Shared MEM data root already contains files without an authority marker: ${INTERACTIVE_MEM_DATA_ROOT}. Refusing to merge or overwrite it."
    fi

    mkdir -p "${INTERACTIVE_MEM_DATA_ROOT}/control-plane"
    mkdir -p "${LEGACY_LOCAL_MEM_DATA_ROOT}"

    local repair_root staged_dir missing_file target_dir backup_dir
    repair_root="$(mktemp -d "${INTERACTIVE_STATE}/.mem-data-repair.XXXXXX")"
    staged_dir="${repair_root}/runtime-stacks"
    missing_file="${repair_root}/missing.tsv"
    target_dir="${INTERACTIVE_MEM_DATA_ROOT}/control-plane/runtime-stacks"
    backup_dir="${repair_root}/previous-runtime-stacks"
    mkdir -p "${staged_dir}"
    : > "${missing_file}"

    python3 - \
        "${INTERACTIVE_SQLITE_PATH}" \
        "${LEGACY_LOCAL_MEM_DATA_ROOT}/control-plane/runtime-stacks" \
        "${target_dir}" \
        "${staged_dir}" \
        "${missing_file}" <<'PY'
import json
import pathlib
import shutil
import sqlite3
import sys

db_path = pathlib.Path(sys.argv[1])
legacy_dir = pathlib.Path(sys.argv[2])
current_dir = pathlib.Path(sys.argv[3])
staged_dir = pathlib.Path(sys.argv[4])
missing_file = pathlib.Path(sys.argv[5])

def norm(value):
    return (value or "").strip().lower()

def norm_id(value):
    return norm(value).replace("-", "")

if not db_path.is_file():
    raise SystemExit(f"Shared Control Plane database does not exist: {db_path}")

con = sqlite3.connect(str(db_path))
try:
    rows = con.execute(
        'SELECT Id, Slug, Status, LastVerifiedStatus FROM RuntimeStacks'
    ).fetchall()
finally:
    con.close()

active = []
for stack_id, slug, status, last_verified in rows:
    destroyed = (
        norm(status) == "destroyed"
        or norm(last_verified) == "destroyed"
        or "--destroyed-" in norm(slug)
    )
    if not destroyed:
        active.append((norm_id(stack_id), stack_id, slug))

candidate_dirs = [current_dir, legacy_dir]
candidates = []
for rank, directory in enumerate(candidate_dirs):
    if not directory.is_dir():
        continue
    for path in sorted(directory.glob("*.json")):
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception as exc:
            raise SystemExit(f"Unreadable runtime manifest {path}: {exc}")
        candidates.append({
            "path": path,
            "stack_id": norm_id(payload.get("stackId")),
            "slug": norm(payload.get("slug")),
            "rank": rank,
            "legacy": directory == legacy_dir,
        })

staged_dir.mkdir(parents=True, exist_ok=True)
used = set()
imported = []
missing = []

for active_id, raw_id, raw_slug in active:
    exact = [item for item in candidates if item["stack_id"] == active_id]
    exact.sort(key=lambda item: (item["rank"], str(item["path"])))
    if exact:
        source = exact[0]
        destination = staged_dir / f"{active_id}.json"
        shutil.copy2(source["path"], destination)
        imported.append((raw_id, raw_slug, source["path"]))
        used.add(source["path"])
        continue
    missing.append((raw_id, raw_slug))

with missing_file.open("w", encoding="utf-8") as handle:
    for raw_id, raw_slug in missing:
        handle.write(f"{raw_id}\t{raw_slug}\n")

legacy_candidates = [item for item in candidates if item["legacy"]]
retired = [item for item in legacy_candidates if item["path"] not in used]
current_mismatches = [
    item for item in candidates
    if not item["legacy"] and item["path"] not in used
]

print(f"Active durable stacks: {len(active)}")
print(f"Exact active manifests imported: {len(imported)}")
for raw_id, raw_slug, source in imported:
    print(f"  imported {raw_slug} ({raw_id}) from {source}")
if missing:
    print(f"Active manifests requiring database reconstruction: {len(missing)}")
    for raw_id, raw_slug in missing:
        print(f"  reconstruct {raw_slug} ({raw_id})")
if retired:
    print(f"Legacy manifests deliberately left retired: {len(retired)}")
    for item in retired:
        print(f"  retired {item['slug'] or '<unknown>'} ({item['stack_id'] or '<unknown>'}) at {item['path']}")
if current_mismatches:
    print(f"Canonical manifests rejected by exact identity validation: {len(current_mismatches)}")
    for item in current_mismatches:
        print(f"  rejected {item['slug'] or '<unknown>'} ({item['stack_id'] or '<unknown>'}) at {item['path']}")
PY

