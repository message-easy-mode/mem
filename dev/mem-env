authority_adopt() {
    local source="$1"
    case "${source}" in
        local|container) ;;
        *) die "authority adopt requires local or container" ;;
    esac

    require_docker
    require_command tar
    require_command python3
    require_command ss
    assert_authority_adoption_safe

    [[ ! -e "${INTERACTIVE_STATE}" ]] ||
        die "Shared interactive authority already exists. Refusing to replace it during adoption."

    if [[ "${source}" == local ]]; then
        legacy_local_state_present || die "No legacy local Control Plane state was found at ${LEGACY_LOCAL_DATA_ROOT}."
    else
        legacy_container_state_present || die "Legacy container state volume ${LEGACY_CONTAINER_VOLUME_NAME} was not found."
    fi

    local temp_root="${STATE_ROOT}/interactive.import.$$"
    [[ ! -e "${temp_root}" ]] || die "Temporary authority import path already exists: ${temp_root}"
    mkdir -p "${temp_root}/data"
    trap 'rm -rf -- "${temp_root}"' RETURN

    if [[ "${source}" == local ]]; then
        assert_legacy_local_resource_adoption_safe
        copy_tree_current_user "${LEGACY_LOCAL_DATA_ROOT}" "${temp_root}/data"
        canonicalize_legacy_local_data "${temp_root}/data"

        if [[ ! -s "${temp_root}/data/setup-token" && -s "${LOCAL_STATE}/setup-token" ]]; then
            cp "${LOCAL_STATE}/setup-token" "${temp_root}/data/setup-token"
            chmod 600 "${temp_root}/data/setup-token"
        fi

    else
        copy_legacy_container_volume "${temp_root}/data"
    fi

    if [[ ! -s "${temp_root}/data/setup-token" ]]; then
        umask 077
        generate_setup_token > "${temp_root}/data/setup-token"
    fi
    chmod 600 "${temp_root}/data/setup-token"
    ensure_development_certificate "${temp_root}/data"
    write_authority_metadata "${temp_root}" "${source}"

    mv "${temp_root}" "${INTERACTIVE_STATE}"
    mkdir -p "${INTERACTIVE_HOST_DATA_ROOT}"
    trap - RETURN
    write_env_file "${INTERACTIVE_LEGACY_RETIREMENT_FILE}" \
        "MEM_INTERACTIVE_LEGACY_RETIRED=1" \
        "MEM_INTERACTIVE_LEGACY_SOURCE=${source}" \
        "MEM_INTERACTIVE_LEGACY_RETIRED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    repair_interactive_mem_data

    log "Adopted ${source} development state as the shared interactive Control Plane authority."
    log "Legacy source state was preserved and is now ignored by ordinary local/container starts."
}

