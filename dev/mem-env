canonicalize_legacy_local_data() {
    local data_root="$1"
    local old_db="${data_root}/mem-installer.dev.db"
    local new_db="${data_root}/mem-control-plane.dev.db"

    if [[ -e "${old_db}" && -e "${new_db}" ]]; then
        die "Local legacy import contains both mem-installer.dev.db and mem-control-plane.dev.db; refusing an ambiguous database choice."
    fi
    if [[ -e "${old_db}" ]]; then
        mv "${old_db}" "${new_db}"
        [[ ! -e "${old_db}-wal" ]] || mv "${old_db}-wal" "${new_db}-wal"
        [[ ! -e "${old_db}-shm" ]] || mv "${old_db}-shm" "${new_db}-shm"
    fi

    local old_keys="${data_root}/mem-data-protection-keys"
    local new_keys="${data_root}/data-protection-keys"
    if [[ -d "${old_keys}" && -d "${new_keys}" ]]; then
        die "Local legacy import contains both old and canonical Data Protection key-ring directories; refusing an ambiguous key-ring choice."
    fi
    [[ ! -d "${old_keys}" ]] || mv "${old_keys}" "${new_keys}"
}

