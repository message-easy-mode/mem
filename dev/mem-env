normalize_interactive_local_ownership() {
    local -a mounts=()
    local -a targets=()

    if [[ -d "${INTERACTIVE_DATA_ROOT}" ]]; then
        mounts+=( -v "${INTERACTIVE_DATA_ROOT}:/control-plane-data" )
        targets+=( /control-plane-data )
    fi
    if [[ -d "${INTERACTIVE_MEM_DATA_ROOT}" ]]; then
        mounts+=( -v "${INTERACTIVE_MEM_DATA_ROOT}:/mem-data" )
        targets+=( /mem-data )
    fi
    [[ ${#targets[@]} -gt 0 ]] || return 0

    require_docker
    require_command id
    docker run --rm \
        "${mounts[@]}" \
        alpine:3.20 chown -R "$(id -u):$(id -g)" "${targets[@]}" >/dev/null
}

interactive_host_data_validate_root() {
    [[ -d "${INTERACTIVE_HOST_DATA_ROOT}" ]] || return 1

    require_command realpath

    [[ ! -L "${INTERACTIVE_HOST_DATA_ROOT}" ]] ||
        die "Shared development host-data root may not be a symlink: ${INTERACTIVE_HOST_DATA_ROOT}"

    local expected_root actual_root
    expected_root="$(realpath -m "${CONTAINER_STATE}/host-data")"
    actual_root="$(realpath -e "${INTERACTIVE_HOST_DATA_ROOT}")"
    [[ "${actual_root}" == "${expected_root}" ]] ||
        die "Shared development host-data root resolved outside the expected authority boundary: ${actual_root}"
}

interactive_host_data_scope_has_symlink() {
    local scope="$1"
    [[ -d "${scope}" ]] || return 1

    local linked_entry
    if ! linked_entry="$(find -P "${scope}" \
        -path '*/media_store' -prune -o \
        -type l -print -quit 2>/dev/null)"; then
        # The ordinary developer account may not yet be able to traverse
        # container-created control directories. Treat that as unknown here;
        # the privileged ACL-reconciliation path performs the authoritative
        # symlink inspection before mutating anything recursively.
        return 2
    fi

    [[ -n "${linked_entry}" ]]
}

interactive_host_data_scope_has_symlink_privileged() {
    local scope="$1"
    local find_bin="$2"
    [[ -d "${scope}" ]] || return 1

    local linked_entry
    if ! linked_entry="$(sudo -- "${find_bin}" -P "${scope}" \
        -path '*/media_store' -prune -o \
        -type l -print -quit 2>/dev/null)"; then
        die "Could not inspect the bounded shared host-data scope safely under privileged traversal."
    fi

    [[ -n "${linked_entry}" ]]
}

interactive_host_data_verify_local_access() {
    [[ -d "${INTERACTIVE_HOST_DATA_ROOT}" ]] || return 0
    interactive_host_data_validate_root

    [[ -w "${INTERACTIVE_HOST_DATA_ROOT}" ]] || return 1

    if [[ -d "${INTERACTIVE_HOST_DATA_ROOT}/instances" ]]; then
        local inaccessible_path
        if ! inaccessible_path="$(find -P "${INTERACTIVE_HOST_DATA_ROOT}/instances" \
            -path '*/media_store' -prune -o \
            \( -type d -o -type f \) ! -writable -print -quit 2>/dev/null)"; then
            return 1
        fi
        [[ -z "${inaccessible_path}" ]] || return 1
    fi

    return 0
}

interactive_host_data_access_marker_matches() {
    [[ -f "${INTERACTIVE_HOST_DATA_ACCESS_FILE}" ]] || return 1

    local developer_uid expected_root actual_root
    developer_uid="$(id -u)"
    expected_root="$(realpath -m "${CONTAINER_STATE}/host-data")"
    actual_root="$(realpath -e "${INTERACTIVE_HOST_DATA_ROOT}")"

    local recorded_version recorded_uid recorded_root
    recorded_version="$(sed -n 's/^MEM_DEV_HOST_DATA_ACCESS_VERSION=//p' "${INTERACTIVE_HOST_DATA_ACCESS_FILE}" | head -n 1)"
    recorded_uid="$(sed -n 's/^MEM_DEV_HOST_DATA_ACCESS_UID=//p' "${INTERACTIVE_HOST_DATA_ACCESS_FILE}" | head -n 1)"
    recorded_root="$(sed -n 's/^MEM_DEV_HOST_DATA_ACCESS_ROOT=//p' "${INTERACTIVE_HOST_DATA_ACCESS_FILE}" | head -n 1)"

    [[ "${recorded_version}" == "2" &&
       "${recorded_uid}" == "${developer_uid}" &&
       "${recorded_root}" == "${actual_root}" &&
       "${actual_root}" == "${expected_root}" ]]
}

prepare_interactive_host_data_for_local_mutation() {
    [[ -d "${INTERACTIVE_HOST_DATA_ROOT}" ]] || return 0

    require_command find
    require_command id
    require_command realpath

    interactive_host_data_validate_root

    if interactive_host_data_scope_has_symlink "${INTERACTIVE_HOST_DATA_ROOT}/instances"; then
        die "Shared development stack host-data contains a symlink outside excluded media payloads. Review it before local operation."
    fi
    if interactive_host_data_verify_local_access; then
        return 0
    fi

    local developer_uid
    developer_uid="$(id -u)"
    die "Shared development host-data is not writable by developer UID ${developer_uid}. Run './dev/mem-env host-data access' while both ordinary Control Plane modes are stopped, then retry local development."
}

reconcile_interactive_host_data_for_local_switch() {
    [[ -d "${INTERACTIVE_HOST_DATA_ROOT}" ]] || return 0

    require_command find
    require_command id
    require_command realpath

    interactive_host_data_validate_root

    local preflight_symlink_status=0
    if interactive_host_data_scope_has_symlink "${INTERACTIVE_HOST_DATA_ROOT}/instances"; then
        die "Shared development stack host-data contains a symlink outside excluded media payloads. Automatic switch reconciliation refused."
    else
        preflight_symlink_status=$?
    fi

    if [[ "${preflight_symlink_status}" -eq 2 ]]; then
        log "Shared development host-data cannot be fully inspected by the developer UID before repair; the privileged bounded reconciliation will validate it before applying recursive ACLs."
    fi

    if interactive_host_data_verify_local_access; then
        log "Shared development host-data already permits local developer mutation."
        return 0
    fi

    local developer_uid
    developer_uid="$(id -u)"
    log "Shared development host-data needs local developer access reconciliation for UID ${developer_uid}."
    log "The containerized Control Plane is stopped; applying the existing bounded ACL contract before local startup."
    host_data_access_apply

    interactive_host_data_verify_local_access ||
        die "Automatic shared host-data reconciliation completed but local developer write access is still unavailable."
}

host_data_access_apply_acl_to_scope() {
    local scope="$1"
    local developer_uid="$2"
    local setfacl_bin="$3"
    local find_bin="$4"

    [[ -d "${scope}" ]] || return 0

    # Container-created control directories may not be traversable by the
    # developer account yet. Run the bounded discovery under the already-
    # authorized sudo context, while keeping the same media-store prune and
    # developer-only ACL contract. This avoids requiring a second manual pass.
    sudo -- "${find_bin}" -P "${scope}" \
        -path '*/media_store' -prune -o \
        -type d -exec \
            "${setfacl_bin}" \
                -m "u:${developer_uid}:rwx" \
                -m "d:u:${developer_uid}:rwx" \
                -- {} +

    sudo -- "${find_bin}" -P "${scope}" \
        -path '*/media_store' -prune -o \
        -type f -exec \
            "${setfacl_bin}" \
                -m "u:${developer_uid}:rw-" \
                -- {} +
}

host_data_access_apply() {
    ensure_interactive_authority
    [[ -d "${INTERACTIVE_HOST_DATA_ROOT}" ]] ||
        die "Shared development host-data does not exist yet: ${INTERACTIVE_HOST_DATA_ROOT}"

    require_command find
    require_command id
    require_command realpath
    require_command sudo
    require_command ss

    interactive_host_data_validate_root

    if port_is_listening 7105 || port_is_listening 5173; then
        die "Shared host-data access refused while the local API or Vite is running. Run './dev/mem-env local down' first."
    fi

    require_docker
    if container_running "${DEV_CONTAINER_NAME}"; then
        die "Shared host-data access refused while ${DEV_CONTAINER_NAME} is running. Run './dev/mem-env container down' first."
    fi

    local setfacl_bin find_bin
    setfacl_bin="$(command -v setfacl 2>/dev/null || true)"
    [[ -n "${setfacl_bin}" ]] ||
        die "Shared host-data access requires 'setfacl' (Ubuntu/Kubuntu package: acl). Install it explicitly first."
    find_bin="$(command -v find 2>/dev/null || true)"
    [[ -n "${find_bin}" ]] ||
        die "Shared host-data access requires 'find'."

    local developer_uid actual_root
    developer_uid="$(id -u)"
    [[ "${developer_uid}" =~ ^[0-9]+$ ]] ||
        die "Could not determine the current developer UID for shared host-data access."
    actual_root="$(realpath -e "${INTERACTIVE_HOST_DATA_ROOT}")"

    log "Shared development stack host-data contains container-owned files."
    log "Authorizing a bounded ACL update for developer UID ${developer_uid}."
    log "Container ownership and normal mode bits will be preserved; Matrix media payloads and protected platform-service secrets are excluded."

    sudo -v ||
        die "Shared host-data access refused because sudo authorization failed."

    if interactive_host_data_scope_has_symlink_privileged \
        "${INTERACTIVE_HOST_DATA_ROOT}/instances" \
        "${find_bin}"; then
        die "Shared development stack host-data contains a symlink outside excluded media payloads. ACL bootstrap refused."
    fi

    # The host-data root receives access for the developer, but deliberately no
    # default ACL. Protected service trees such as platform/coturn retain their
    # owner-only permission contract instead of inheriting developer ACLs.
    sudo -- "${setfacl_bin}" \
        -m "u:${developer_uid}:rwx" \
        -- "${INTERACTIVE_HOST_DATA_ROOT}"

    mkdir -p "${INTERACTIVE_HOST_DATA_ROOT}/instances"

    host_data_access_apply_acl_to_scope \
        "${INTERACTIVE_HOST_DATA_ROOT}/instances" \
        "${developer_uid}" \
        "${setfacl_bin}" \
        "${find_bin}"

    interactive_host_data_verify_local_access ||
        die "Shared host-data ACL bootstrap completed but the local developer still lacks required write access. No authority marker was recorded."

    write_env_file "${INTERACTIVE_HOST_DATA_ACCESS_FILE}" \
        "MEM_DEV_HOST_DATA_ACCESS_VERSION=2" \
        "MEM_DEV_HOST_DATA_ACCESS_UID=${developer_uid}" \
        "MEM_DEV_HOST_DATA_ACCESS_ROOT=${actual_root}"

    log "Shared development host-data access is ready for local source operation."
}

host_data_access_status() {
    ensure_interactive_authority

    printf 'MEM shared development host-data access\n\n'
    status_line "Host data root" "${INTERACTIVE_HOST_DATA_ROOT}"

    if [[ ! -d "${INTERACTIVE_HOST_DATA_ROOT}" ]]; then
        status_line "Local mutation access" "not required · host-data not created"
        return 0
    fi

    require_command find
    require_command id
    require_command realpath
    interactive_host_data_validate_root

    if interactive_host_data_verify_local_access; then
        if interactive_host_data_access_marker_matches; then
            status_line "Local mutation access" "ready · bounded ACL authority recorded"
        else
            status_line "Local mutation access" "currently writable · ACL authority marker not recorded"
        fi
    else
        status_line "Local mutation access" "repair required · run ./dev/mem-env host-data access"
    fi
}

host_data_command() {
    local action="${1:-}"
    [[ $# -eq 1 ]] || die "host-data requires exactly one action: status or access"

    case "${action}" in
        status) host_data_access_status ;;
        access) host_data_access_apply ;;
        *) die "host-data requires status or access" ;;
    esac
}

ensure_local_environment() {
    ensure_interactive_authority
    normalize_interactive_local_ownership
    prepare_interactive_host_data_for_local_mutation
    mkdir -p "${LOCAL_STATE}"

    write_env_file "${LOCAL_STATE}/runtime.env" \
        "MEM_RUNTIME_MODE=local-development" \
        "MEM_STATE_ROOT=${INTERACTIVE_DATA_ROOT}" \
        "MEM_DATA_ROOT=${INTERACTIVE_MEM_DATA_ROOT}" \
        "MEM_API_URL=${LOCAL_API_URL}" \
        "MEM_WEB_URL=${LOCAL_WEB_URL}"
}

resolve_product_version() {
    python3 - "${REPO_ROOT}/installer/src/Api/appsettings.json" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8-sig") as handle:
    print(json.load(handle).get("Product", {}).get("Version", "0.2.0"))
PY
}

resolve_commit() {
    git -C "${REPO_ROOT}" rev-parse --short=12 HEAD 2>/dev/null || printf 'unknown\n'
}

ensure_container_environment() {
    require_command python3
    mkdir -p "${CONTAINER_STATE}"
    local version commit build_date
    version="$(resolve_product_version)"
    commit="$(resolve_commit)"
    build_date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    write_env_file "${CONTAINER_STATE}/runtime.env" \
        "MEM_CONTROL_PLANE_IMAGE=mem-control-plane:local" \
        "MEM_CONTROL_PLANE_HTTPS_PORT=${CONTAINER_HTTPS_PORT}" \
        "MEM_CONTROL_PLANE_STATE_ROOT=${INTERACTIVE_DATA_ROOT}" \
        "MEM_CONTROL_PLANE_MEM_DATA_ROOT=${INTERACTIVE_MEM_DATA_ROOT}" \
        "MEM_CONTROL_PLANE_LEGACY_MEM_DATA_ROOT=${LEGACY_LOCAL_MEM_DATA_ROOT}" \
        "MEM_CONTROL_PLANE_HOST_DATA_ROOT=${INTERACTIVE_HOST_DATA_ROOT}" \
        "MEM_CONTROL_PLANE_NETWORK_NAME=${DEV_NETWORK_NAME}" \
        "MEM_PRODUCT_VERSION=${version}" \
        "MEM_COMMIT_SHA=${commit}" \
        "MEM_BUILD_DATE=${build_date}"
}

compose() {
    docker compose \
        --env-file "${CONTAINER_STATE}/runtime.env" \
        --file "${COMPOSE_FILE}" \
        "$@"
}

container_exists() {
    docker ps -a --format '{{.Names}}' | grep -Fxq "$1"
}

container_running() {
    docker ps --format '{{.Names}}' | grep -Fxq "$1"
}

seq_container_name_for_mode() {
    case "$1" in
        local) printf '%s\n' "${LOCAL_SEQ_CONTAINER_NAME}" ;;
        container) printf '%s\n' "${CONTAINER_SEQ_CONTAINER_NAME}" ;;
        *) return 1 ;;
    esac
}

seq_runtime_mode_for_mode() {
    case "$1" in
        local) printf '%s\n' 'local-development' ;;
        container) printf '%s\n' 'containerized-development' ;;
        *) return 1 ;;
    esac
}

seq_preferred_host_port_for_mode() {
    case "$1" in
        local) printf '%s\n' "${LOCAL_SEQ_PREFERRED_HOST_PORT}" ;;
        container) printf '%s\n' "${CONTAINER_SEQ_PREFERRED_HOST_PORT}" ;;
        *) return 1 ;;
    esac
}

docker_container_label() {
    local name="$1"
    local key="$2"
    docker inspect --format "{{with index .Config.Labels \"${key}\"}}{{.}}{{end}}" "${name}" 2>/dev/null || true
}

seq_container_has_expected_context_labels() {
    local mode="$1"
    local name expected_runtime managed service runtime_mode
    name="$(seq_container_name_for_mode "${mode}")" || return 1
    expected_runtime="$(seq_runtime_mode_for_mode "${mode}")" || return 1
    managed="$(docker_container_label "${name}" "${SEQ_MANAGED_LABEL}")"
    service="$(docker_container_label "${name}" "${SEQ_SERVICE_LABEL}")"
    runtime_mode="$(docker_container_label "${name}" "${SEQ_RUNTIME_MODE_LABEL}")"

    [[ "${managed}" == "true" &&
       "${service}" == "seq" &&
       "${runtime_mode}" == "${expected_runtime}" ]]
}

seq_container_state() {
    docker inspect --format '{{.State.Status}}' "$1" 2>/dev/null || true
}

seq_container_host_port() {
    docker port "$1" 80/tcp 2>/dev/null | awk -F: 'NR == 1 { print $NF }'
}

seq_container_data_source() {
    docker inspect --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{end}}{{end}}' "$1" 2>/dev/null || true
}

other_managed_seq_container_names() {
    local name
    docker ps -a \
        --filter "label=${SEQ_MANAGED_LABEL}=true" \
        --filter "label=${SEQ_SERVICE_LABEL}=seq" \
        --format '{{.Names}}' 2>/dev/null | while IFS= read -r name; do
        [[ -n "${name}" ]] || continue
        if [[ "${name}" != "${LOCAL_SEQ_CONTAINER_NAME}" &&
              "${name}" != "${CONTAINER_SEQ_CONTAINER_NAME}" ]]; then
            printf '%s\n' "${name}"
        fi
    done
}

runtime_control_plane_instance_for_mode() {
    local mode="$1"
    local url insecure expected_runtime payload
    case "${mode}" in
        local)
            url="${LOCAL_API_URL}"
            insecure=false
            expected_runtime=local-development
            ;;
        container)
            url="${CONTAINER_URL}"
            insecure=true
            expected_runtime=containerized-development
            ;;
        *) return 1 ;;
    esac

    payload="$(runtime_json "${url}" "${insecure}" 2>/dev/null)" || return 1
    printf '%s' "${payload}" | python3 -c '
import json, sys
expected=sys.argv[1]
v=json.load(sys.stdin)
if v.get("runtimeMode") != expected:
    raise SystemExit(1)
owner=v.get("controlPlaneInstanceId")
if not owner:
    raise SystemExit(1)
print(owner)
' "${expected_runtime}"
}

seq_context_status() {
    local mode="$1"
    local name runtime_mode preferred_port state host_port owner active_owner ownership
    name="$(seq_container_name_for_mode "${mode}")" || die "Unknown Seq context: ${mode}"
    runtime_mode="$(seq_runtime_mode_for_mode "${mode}")"
    preferred_port="$(seq_preferred_host_port_for_mode "${mode}")"

    if ! container_exists "${name}"; then
        status_line "Seq ${runtime_mode}" "not created · ${name} · preferred host port ${preferred_port}"
        return 0
    fi

    state="$(seq_container_state "${name}")"
    host_port="$(seq_container_host_port "${name}")"
    [[ -n "${host_port}" ]] || host_port="not published"
    status_line "Seq ${runtime_mode}" "${state:-unknown} · ${name} · host port ${host_port}"

    if ! seq_container_has_expected_context_labels "${mode}"; then
        status_line "Seq ownership" "label mismatch · read-only inspection only"
        return 0
    fi

    owner="$(docker_container_label "${name}" "${SEQ_CONTROL_PLANE_INSTANCE_LABEL}")"
    active_owner="$(runtime_control_plane_instance_for_mode "${mode}" 2>/dev/null || true)"
    if [[ -z "${owner}" ]]; then
        ownership="owner label missing"
    elif [[ -z "${active_owner}" ]]; then
        ownership="owned by ${owner} · active Control Plane unavailable"
    elif [[ "${owner}" == "${active_owner}" ]]; then
        ownership="matches active Control Plane · ${owner}"
    else
        ownership="different Control Plane · owner ${owner} · active ${active_owner}"
    fi
    status_line "Seq ownership" "${ownership}"
}

seq_safe_inspect() {
    local mode="$1"
    local name runtime_mode preferred_port state host_port data_source managed service runtime_label owner active_owner ownership
    name="$(seq_container_name_for_mode "${mode}")" || die "Unknown Seq context: ${mode}"
    runtime_mode="$(seq_runtime_mode_for_mode "${mode}")"
    preferred_port="$(seq_preferred_host_port_for_mode "${mode}")"
    container_exists "${name}" || die "Seq container ${name} does not exist."

    state="$(seq_container_state "${name}")"
    host_port="$(seq_container_host_port "${name}")"
    data_source="$(seq_container_data_source "${name}")"
    managed="$(docker_container_label "${name}" "${SEQ_MANAGED_LABEL}")"
    service="$(docker_container_label "${name}" "${SEQ_SERVICE_LABEL}")"
    runtime_label="$(docker_container_label "${name}" "${SEQ_RUNTIME_MODE_LABEL}")"
    owner="$(docker_container_label "${name}" "${SEQ_CONTROL_PLANE_INSTANCE_LABEL}")"
    active_owner="$(runtime_control_plane_instance_for_mode "${mode}" 2>/dev/null || true)"

    if [[ -z "${owner}" ]]; then
        ownership="unproven"
    elif [[ -z "${active_owner}" ]]; then
        ownership="active Control Plane unavailable"
    elif [[ "${owner}" == "${active_owner}" ]]; then
        ownership="matches active Control Plane"
    else
        ownership="different Control Plane"
    fi

    printf 'Seq development context\n\n'
    status_line "Context" "${runtime_mode}"
    status_line "Container" "${name}"
    status_line "State" "${state:-unknown}"
    status_line "Preferred host port" "${preferred_port}"
    status_line "Observed host port" "${host_port:-not published}"
    status_line "Data source" "${data_source:-not reported}"
    status_line "Managed label" "${managed:-missing}"
    status_line "Service label" "${service:-missing}"
    status_line "Runtime label" "${runtime_label:-missing}"
    status_line "Control Plane owner" "${owner:-missing}"
    status_line "Ownership" "${ownership}"
}

seq_logs() {
    local mode="$1"
    local name
    name="$(seq_container_name_for_mode "${mode}")" || die "Unknown Seq context: ${mode}"
    container_exists "${name}" || die "Seq container ${name} does not exist."
    seq_container_has_expected_context_labels "${mode}" ||
        die "Refusing to follow logs for ${name}; its MEM context labels do not match ${mode}."
    docker logs --follow --tail 200 "${name}"
}

remove_scoped_seq_for_reset() {
    local mode="$1"
    local name
    name="$(seq_container_name_for_mode "${mode}")" || die "Unknown Seq context: ${mode}"
    container_exists "${name}" || return 0
    seq_container_has_expected_context_labels "${mode}" ||
        die "Reset refused. Seq container ${name} exists but its MEM context labels do not match ${mode}."
    docker rm --force "${name}" >/dev/null
    log "Removed context-scoped Seq runtime ${name}; its state is deleted by the enclosing development reset."
}

ensure_runtime_network() {
    local network_name="$1"

    if docker network inspect "${network_name}" >/dev/null 2>&1; then
        return 0
    fi

    docker network create \
        --driver bridge \
        --label "${MEM_MANAGED_LABEL}=true" \
        --label "${MEM_RESOURCE_LABEL}=development-network" \
        "${network_name}" >/dev/null
}

ensure_state_path_material() {
    local data_root="$1"
    local token_file="$2"
    [[ -s "${token_file}" ]] || die "Development setup token is missing: ${token_file}"
    mkdir -p "${data_root}"
    if [[ "${token_file}" != "${data_root}/setup-token" ]]; then
        umask 077
        cp "${token_file}" "${data_root}/setup-token"
    fi
    chmod 600 "${data_root}/setup-token"
    ensure_development_certificate "${data_root}"
}


runtime_json() {
    local url="$1"
    local insecure="${2:-false}"
    local args=(--fail --silent --show-error --max-time 4)
    [[ "${insecure}" == true ]] && args+=(--insecure)
    curl "${args[@]}" "${url}/health/runtime"
}

format_runtime_json() {
    python3 -c '
import json, sys
v=json.load(sys.stdin)
print("Runtime mode              {}".format(v.get("runtimeMode", "unknown")))
print("Control Plane instance    {}".format(v.get("controlPlaneInstanceId", "unknown")))
print("API process instance      {}".format(v.get("apiProcessInstanceId", "unknown")))
print("UI delivery               {}".format(v.get("uiDeliveryMode", "unknown")))
print("Version                   {}".format(v.get("version", "unknown")))
print("Validation                {}".format(v.get("validationState", "unknown")))
'
}

assert_runtime() {
    local url="$1"
    local expected_mode="$2"
    local expected_ui="$3"
    local insecure="${4:-false}"
    runtime_json "${url}" "${insecure}" | python3 -c '
import json, sys
expected_mode=sys.argv[1]
expected_ui=sys.argv[2]
v=json.load(sys.stdin)
if v.get("runtimeMode") != expected_mode:
    raise SystemExit(f"expected runtime mode {expected_mode}, received {v.get(chr(114)+chr(117)+chr(110)+chr(116)+chr(105)+chr(109)+chr(101)+chr(77)+chr(111)+chr(100)+chr(101))}")
if v.get("uiDeliveryMode") != expected_ui:
    raise SystemExit(f"expected UI mode {expected_ui}, received {v.get(chr(117)+chr(105)+chr(68)+chr(101)+chr(108)+chr(105)+chr(118)+chr(101)+chr(114)+chr(121)+chr(77)+chr(111)+chr(100)+chr(101))}")
' "${expected_mode}" "${expected_ui}"
}

wait_for_runtime() {
    local url="$1"
    local expected_mode="$2"
    local expected_ui="$3"
    local insecure="${4:-false}"
    for _ in $(seq 1 90); do
        if assert_runtime "${url}" "${expected_mode}" "${expected_ui}" "${insecure}" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

ensure_port_free() {
    local port="$1"
    local label="$2"
    if port_is_listening "${port}"; then
        die "${label} port ${port} is already occupied. The harness will not kill or remap an unrelated process."
    fi
}

local_up() {
    local watch_enabled="${1:-true}"
    [[ "${watch_enabled}" == true || "${watch_enabled}" == false ]] ||
        die "Internal local API watch mode must be true or false."

    require_command dotnet
    require_command npm
    require_command curl
    require_command python3
    require_command ss
    require_command setsid
    require_docker
    require_exclusive_docker_host ""

    if managed_process_running "${LOCAL_STATE}/api.pid" "Api.csproj" ||
       managed_process_running "${LOCAL_STATE}/vite.pid" "run dev"; then
        die "The local environment is already running under this harness."
    fi

    ensure_port_free 7105 "Local API"
    ensure_port_free 5173 "Vite"
    ensure_local_environment

    if [[ ! -d "${WEB_ROOT}/node_modules" ]]; then
        log "Installing Web dependencies with npm ci."
        (cd "${WEB_ROOT}" && npm ci)
    fi

    local -a api_command
    if [[ "${watch_enabled}" == true ]]; then
        api_command=(
            dotnet watch
            --project "${LOCAL_API_PROJECT}"
            --no-hot-reload
            --non-interactive
            run
            --no-launch-profile
        )
        log "Managed local API source watch is enabled; backend saves trigger a full API restart."
    else
        api_command=(
            dotnet run
            --project "${LOCAL_API_PROJECT}"
            --no-launch-profile
        )
        log "Managed local API source watch is disabled for this session."
    fi

    start_managed_process \
        "local API" \
        "${LOCAL_STATE}/api.pid" \
        "${LOCAL_STATE}/api.log" \
        "Api.csproj" \
        env \
            ASPNETCORE_ENVIRONMENT=Development \
            ASPNETCORE_URLS="${LOCAL_API_URL}" \
            MEM_RUNTIME_MODE=local-development \
            MEM_STATE_ROOT="${INTERACTIVE_DATA_ROOT}" \
            MEM_DATA_ROOT="${INTERACTIVE_MEM_DATA_ROOT}" \
            MEM_CONTROL_PLANE_SETUP_TOKEN_PATH="${INTERACTIVE_SETUP_TOKEN_PATH}" \
            MEM_DEV_ALLOW_SHARED_DOCKER_HOST=false \
            InstallerAuth__DevelopmentSetupToken= \
            MemRuntime__UiDeliveryMode=vite \
            Aio__SqlitePath="${INTERACTIVE_SQLITE_PATH}" \
            DataProtection__KeyRingPath="${INTERACTIVE_DATA_ROOT}/data-protection-keys" \
            Certificates__Storage__RootPath="${INTERACTIVE_DATA_ROOT}/certificates" \
            Diagnostics__Logging__FilePath="${INTERACTIVE_DATA_ROOT}/logs/control-plane/mem-control-plane-.clef" \
            Diagnostics__SafeEvents__RootPath="${INTERACTIVE_DATA_ROOT}/diagnostics" \
            Diagnostics__Seq__HostDataPath="${INTERACTIVE_HOST_DATA_ROOT}/seq" \
            Diagnostics__Seq__DeliveryStatePath="${INTERACTIVE_DATA_ROOT}/diagnostics/seq-delivery.json" \
            Diagnostics__Seq__SecretRootPath="${INTERACTIVE_DATA_ROOT}/secrets/seq" \
            Diagnostics__Seq__BootstrapStatePath="${INTERACTIVE_DATA_ROOT}/diagnostics/seq-bootstrap.json" \
            Diagnostics__Seq__ApiKeyFilePath="${INTERACTIVE_DATA_ROOT}/secrets/seq/ingestion-api-key" \
            Diagnostics__Seq__AdminPasswordHashFilePath="${INTERACTIVE_DATA_ROOT}/secrets/seq/admin-password-hash" \
            Provisioning__InstanceDataRoot="${INTERACTIVE_HOST_DATA_ROOT}/instances" \
            Coturn__StorageRootPath="${INTERACTIVE_HOST_DATA_ROOT}/platform/coturn" \
        "${api_command[@]}"

    if ! wait_for_runtime "${LOCAL_API_URL}" local-development vite false; then
        tail -n 120 "${LOCAL_STATE}/api.log" >&2 || true
        local_down || true
        die "The local API did not report the expected authoritative runtime context."
    fi

    start_managed_process \
        "Vite UI" \
        "${LOCAL_STATE}/vite.pid" \
        "${LOCAL_STATE}/vite.log" \
        "run dev" \
        env npm --prefix "${WEB_ROOT}" run dev -- \
            --host 127.0.0.1 \
            --port 5173 \
            --strictPort

    for _ in $(seq 1 60); do
        if curl --fail --silent --show-error --max-time 3 "${LOCAL_WEB_URL}/health/ready" >/dev/null 2>&1; then
            log "Local development is running: ${LOCAL_WEB_URL}"
            log "Setup token: ./dev/mem-env local token"
            return 0
        fi
        sleep 1
    done

    tail -n 120 "${LOCAL_STATE}/vite.log" >&2 || true
    local_down || true
    die "Vite did not become reachable on the expected port."
}

local_down() {
    local result=0
    local api_shutdown_signal="TERM"

    # dotnet watch treats termination of its child application as a normal
    # watched-process exit and can remain alive waiting for a source change.
    # Request Ctrl+C semantics from the owned watch process group so both the
    # ASP.NET Core child and the watcher complete their normal shutdown path.
    if managed_process_running "${LOCAL_STATE}/api.pid" "dotnet watch"; then
        api_shutdown_signal="INT"
    fi

    stop_managed_process "Vite UI" "${LOCAL_STATE}/vite.pid" "run dev" || result=1
    stop_managed_process \
        "local API" \
        "${LOCAL_STATE}/api.pid" \
        "Api.csproj" \
        "${api_shutdown_signal}" || result=1
    return "${result}"
}

local_logs() {
    mkdir -p "${LOCAL_STATE}"
    touch "${LOCAL_STATE}/api.log" "${LOCAL_STATE}/vite.log"
    tail -n 200 -F "${LOCAL_STATE}/api.log" "${LOCAL_STATE}/vite.log"
}

container_build() {
    require_docker
    require_command python3
    ensure_container_environment
    log "Building production-shaped image mem-control-plane:local."
    compose build mem-control-plane
}

container_up() {
    require_docker
    require_command curl
    require_command python3
    require_command ss
    validate_port "${CONTAINER_HTTPS_PORT}" || die "Invalid container HTTPS port: ${CONTAINER_HTTPS_PORT}"

    if managed_process_running "${LOCAL_STATE}/api.pid" "Api.csproj" ||
       managed_process_running "${LOCAL_STATE}/vite.pid" "run dev"; then
        die "The local source environment is active. Use './dev/mem-env switch container' for a safe transition."
    fi

    if port_is_listening 7105 || port_is_listening 5173; then
        die "A local API or Vite listener is active outside this harness. Stop it explicitly before starting the containerized Control Plane."
    fi

    require_exclusive_docker_host "${DEV_CONTAINER_NAME}"
    ensure_interactive_authority
    ensure_container_environment
    ensure_runtime_network "${DEV_NETWORK_NAME}"

    if container_running "${DEV_CONTAINER_NAME}"; then
        assert_runtime "${CONTAINER_URL}" containerized-development embedded-spa true ||
            die "The running development container does not expose the expected runtime context."
        log "Containerized development is already running: ${CONTAINER_URL}"
        return 0
    fi

    ensure_port_free "${CONTAINER_HTTPS_PORT}" "Containerized Control Plane"
    docker image inspect mem-control-plane:local >/dev/null 2>&1 ||
        die "Local image mem-control-plane:local is missing. Run './dev/mem-env container build' first."

    ensure_interactive_material
    compose up --detach --no-build mem-control-plane

    if ! wait_for_runtime "${CONTAINER_URL}" containerized-development embedded-spa true; then
        compose logs --no-color --tail 160 mem-control-plane >&2 || true
        compose down --remove-orphans || true
        die "The container did not report containerized-development with embedded SPA delivery. State was preserved."
    fi

    log "Containerized development is running: ${CONTAINER_URL}"
    log "Setup token: ./dev/mem-env container token"
}

container_down() {
    require_docker
    ensure_container_environment
    compose down --remove-orphans
    normalize_interactive_local_ownership
    log "Containerized development stopped. Shared interactive state was preserved."
}

container_logs() {
    require_docker
    ensure_container_environment
    compose logs --follow --tail 200 mem-control-plane
}

print_token() {
    local mode="$1"
    case "${mode}" in
        local|container)
            require_docker
            ensure_interactive_authority
            cat "${INTERACTIVE_SETUP_TOKEN_PATH}"
            ;;
        *)
            die "Unknown token mode: ${mode}"
            ;;
    esac
}

